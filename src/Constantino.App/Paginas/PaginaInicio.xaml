<Page
    x:Class="Constantino.App.Paginas.PaginaInicio"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ScrollViewer.CanContentScroll="False"
    Title="Inicio">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="1040" HorizontalAlignment="Stretch">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Tu equipo" />
            <TextBlock
                Margin="0,4,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Calíope ha revisado tu ordenador para recomendarte qué instalar. No se ha cambiado nada."
                TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Visibility="{Binding ViewModel.Cargando, Converter={StaticResource BoolAVisibilidad}}">
                <ui:ProgressRing Width="20" Height="20" IsIndeterminate="True" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="Analizando el equipo…" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding ViewModel.Avisos}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:InfoBar
                            Margin="0,0,0,8"
                            IsClosable="False"
                            IsOpen="True"
                            Message="{Binding Mensaje}"
                            Severity="{Binding Severidad}"
                            Title="{Binding Titulo}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Card Grid.Column="0" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Desktop24" FontSize="20" />
                            <TextBlock Margin="8,0,0,0" FontSize="16" FontWeight="SemiBold" Text="Sistema" />
                        </StackPanel>
                        <TextBlock Margin="0,12,0,0" Text="{Binding ViewModel.SistemaOperativo}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding ViewModel.Procesador}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding ViewModel.Memoria}" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="2" VerticalAlignment="Stretch" VerticalContentAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Folder24" FontSize="20" />
                            <TextBlock Margin="8,0,0,0" FontSize="16" FontWeight="SemiBold" Text="Carpeta de datos" />
                        </StackPanel>
                        <TextBlock Margin="0,12,0,0" Text="{Binding ViewModel.CarpetaDatos}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0" Text="{Binding ViewModel.EspacioDisco}" TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Aquí irán las herramientas, los modelos y tus voces. Podrás cambiarla al instalar."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ui:Card>
            </Grid>

            <ui:Card Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="DeveloperBoard24" FontSize="20" />
                        <TextBlock Margin="8,0,0,0" FontSize="16" FontWeight="SemiBold" Text="Tarjeta gráfica" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,12,0,0"
                        Text="No se ha encontrado ninguna tarjeta gráfica."
                        Visibility="{Binding ViewModel.SinGpus, Converter={StaticResource BoolAVisibilidad}}" />
                    <ItemsControl ItemsSource="{Binding ViewModel.Gpus}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Nombre}" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Detalle}"
                                        TextWrapping="Wrap" />
                                    <ProgressBar
                                        Height="6"
                                        Margin="0,8,0,0"
                                        Maximum="100"
                                        ToolTip="Memoria de la tarjeta en uso ahora mismo"
                                        Value="{Binding PorcentajeUso, Mode=OneWay}"
                                        Visibility="{Binding TieneMemoria, Converter={StaticResource BoolAVisibilidad}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="20" />
                        <TextBlock Margin="8,0,0,0" FontSize="16" FontWeight="SemiBold" Text="Qué te recomendamos instalar" />
                    </StackPanel>
                    <TextBlock Margin="0,12,0,8" Text="{Binding ViewModel.ResumenDispositivo}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding ViewModel.Propuesta}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Nombre}" />
                                    <ui:Badge Grid.Column="1" Appearance="{Binding Apariencia}" Content="{Binding Etiqueta}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Tamano}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="{Binding ViewModel.DescargaPropuesta}" />
                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                        <ui:Button Appearance="Primary" Command="{Binding ViewModel.IrAComponentesCommand}" Content="Ver todos los componentes" />
                        <ui:Button Margin="8,0,0,0" Command="{Binding ViewModel.ReanalizarCommand}" Content="Volver a analizar" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
