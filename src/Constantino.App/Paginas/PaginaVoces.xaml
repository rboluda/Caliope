<Page
    x:Class="Constantino.App.Paginas.PaginaVoces"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Constantino.App.ViewModels"
    x:Name="Raiz"
    ScrollViewer.CanContentScroll="False"
    Title="Voces">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="1040">
            <Grid>
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="Voces" />
                <ui:Button
                    HorizontalAlignment="Right"
                    Appearance="Primary"
                    Command="{Binding ViewModel.AbrirImportarCommand}"
                    Content="Importar una voz">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Add24" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
            <TextBlock
                Margin="0,4,0,12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Tu biblioteca de voces. Cada voz es una grabación corta con su transcripción: el motor la imita para leer cualquier texto."
                TextWrapping="Wrap" />

            <!--  Estado del motor  -->
            <ui:Card Margin="0,0,0,12" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon VerticalAlignment="Center" Symbol="DeveloperBoardLightning20" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="Motor de voz: " /><Run Text="{Binding ViewModel.Motor.Descripcion, Mode=OneWay}" />
                    </TextBlock>
                    <ui:Button
                        Grid.Column="2"
                        Margin="12,0,0,0"
                        Command="{Binding ViewModel.ApagarMotorCommand}"
                        Content="Apagar y liberar memoria"
                        Visibility="{Binding ViewModel.Motor.Encendido, Converter={StaticResource BoolAVisibilidad}}" />
                </Grid>
            </ui:Card>

            <ui:InfoBar
                Margin="0,0,0,8"
                IsClosable="False"
                IsOpen="{Binding ViewModel.AvisoImportar, Converter={StaticResource TextoNoVacio}}"
                Message="{Binding ViewModel.AvisoImportar}"
                Severity="Success"
                Title="Listo" />
            <ui:InfoBar
                Margin="0,0,0,8"
                IsClosable="False"
                IsOpen="{Binding ViewModel.ErrorGeneral, Converter={StaticResource TextoNoVacio}}"
                Message="{Binding ViewModel.ErrorGeneral}"
                Severity="Error"
                Title="Algo ha fallado" />

            <!--  Formulario de importación  -->
            <ui:Card Margin="0,0,0,12" Visibility="{Binding ViewModel.MostrarImportar, Converter={StaticResource BoolAVisibilidad}}">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Importar una voz" />
                    <TextBlock
                        Margin="0,4,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Una grabación limpia de 10–20 segundos, de una sola persona, sin música ni ruido de fondo. Sirven WAV, MP3, FLAC, OGG o M4A."
                        TextWrapping="Wrap" />

                    <TextBlock Margin="0,0,0,4" Text="Grabación" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox PlaceholderText="Elige un archivo de audio" Text="{Binding ViewModel.ArchivoImportar, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding ViewModel.ExaminarCommand}" Content="Examinar…">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,4" Text="Nombre" />
                            <ui:TextBox PlaceholderText="Por ejemplo: Narrador de la hoguera" Text="{Binding ViewModel.NombreImportar, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,4" Text="Idioma" />
                            <ComboBox
                                DisplayMemberPath="Nombre"
                                ItemsSource="{Binding ViewModel.IdiomasDisponibles}"
                                SelectedValue="{Binding ViewModel.IdiomaImportar}"
                                SelectedValuePath="Clave" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,12,0,4" Text="Transcripción exacta de la grabación" />
                    <ui:TextBox
                        MinHeight="80"
                        AcceptsReturn="True"
                        IsEnabled="{Binding ViewModel.SinTranscripcionImportar, Converter={StaticResource NegarBool}}"
                        PlaceholderText="Escribe palabra por palabra todo lo que se dice en la grabación. Si hay un .txt con el mismo nombre que el audio, se rellena solo."
                        Text="{Binding ViewModel.TranscripcionImportar, UpdateSourceTrigger=PropertyChanged}"
                        TextWrapping="Wrap" />
                    <CheckBox Margin="0,8,0,0" IsChecked="{Binding ViewModel.SinTranscripcionImportar}">
                        <TextBlock Text="No tengo la transcripción: imitar solo el timbre de la voz (se parece algo menos, pero funciona)." TextWrapping="Wrap" />
                    </CheckBox>

                    <CheckBox Margin="0,12,0,0" IsChecked="{Binding ViewModel.ConsentimientoImportar}">
                        <TextBlock Text="Esta voz es mía, la he creado yo, o tengo permiso de su dueño para usarla." TextWrapping="Wrap" />
                    </CheckBox>

                    <ui:InfoBar
                        Margin="0,12,0,0"
                        IsClosable="False"
                        IsOpen="{Binding ViewModel.ErrorImportar, Converter={StaticResource TextoNoVacio}}"
                        Message="{Binding ViewModel.ErrorImportar}"
                        Severity="Warning"
                        Title="No se puede importar" />

                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <ui:Button
                            Appearance="Primary"
                            Command="{Binding ViewModel.ImportarCommand}"
                            Content="Importar"
                            IsEnabled="{Binding ViewModel.Importando, Converter={StaticResource NegarBool}}" />
                        <ui:Button Margin="8,0,0,0" Command="{Binding ViewModel.CancelarImportarCommand}" Content="Cancelar" />
                        <ui:ProgressRing
                            Width="18"
                            Height="18"
                            Margin="12,0,0,0"
                            IsIndeterminate="True"
                            Visibility="{Binding ViewModel.Importando, Converter={StaticResource BoolAVisibilidad}}" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <!--  Biblioteca vacía  -->
            <ui:Card Visibility="{Binding ViewModel.SinVoces, Converter={StaticResource BoolAVisibilidad}}">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Todavía no tienes voces" />
                    <TextBlock
                        Margin="0,6,0,0"
                        Text="Importa una grabación de 10–20 segundos con su transcripción. Más adelante podrás también diseñar voces describiéndolas o clonarlas grabando con el micrófono."
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <!--  Lista de voces  -->
            <ItemsControl ItemsSource="{Binding ViewModel.Voces}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TarjetaVoz}">
                        <ui:Card Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding Editando, Converter={StaticResource BoolInversoAVisibilidad}}">
                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Nombre}" />
                                            <ui:Badge
                                                Margin="10,0,0,0"
                                                Appearance="Primary"
                                                Content="Predeterminada"
                                                Visibility="{Binding EsPredeterminada, Converter={StaticResource BoolAVisibilidad}}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding Editando, Converter={StaticResource BoolAVisibilidad}}">
                                            <ui:TextBox MinWidth="260" Text="{Binding NombreEditado, UpdateSourceTrigger=PropertyChanged}" />
                                            <ui:Button
                                                Margin="8,0,0,0"
                                                Appearance="Primary"
                                                Command="{Binding DataContext.ViewModel.GuardarNombreCommand, ElementName=Raiz}"
                                                CommandParameter="{Binding}"
                                                Content="Guardar" />
                                            <ui:Button
                                                Margin="8,0,0,0"
                                                Command="{Binding DataContext.ViewModel.CancelarNombreCommand, ElementName=Raiz}"
                                                CommandParameter="{Binding}"
                                                Content="Cancelar" />
                                        </StackPanel>
                                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detalle}" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontStyle="Italic"
                                            MaxHeight="40"
                                            Text="{Binding Transcripcion}"
                                            TextTrimming="WordEllipsis"
                                            TextWrapping="Wrap"
                                            Visibility="{Binding EditandoTranscripcion, Converter={StaticResource BoolInversoAVisibilidad}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top" Orientation="Horizontal">
                                        <ui:Button
                                            Command="{Binding DataContext.ViewModel.EscucharCommand, ElementName=Raiz}"
                                            CommandParameter="{Binding}"
                                            Content="Escuchar"
                                            ToolTip="Escuchar la grabación de referencia">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Play24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button
                                            Margin="6,0,0,0"
                                            Appearance="Primary"
                                            Command="{Binding DataContext.ViewModel.AlternarPruebaCommand, ElementName=Raiz}"
                                            CommandParameter="{Binding}"
                                            Content="Probar">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="PersonVoice24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>

                                <ui:InfoBar
                                    Margin="0,10,0,0"
                                    IsClosable="False"
                                    IsOpen="{Binding AvisoTranscripcion, Converter={StaticResource TextoNoVacio}}"
                                    Message="{Binding AvisoTranscripcion}"
                                    Severity="Warning"
                                    Title="Esta voz saldrá cortada" />

                                <!--  Edición de la transcripción  -->
                                <StackPanel Margin="0,10,0,0" Visibility="{Binding EditandoTranscripcion, Converter={StaticResource BoolAVisibilidad}}">
                                    <TextBlock Margin="0,0,0,4" Text="Transcripción exacta de la grabación (vacía para imitar solo el timbre):" />
                                    <ui:TextBox AcceptsReturn="True" MinHeight="70" Text="{Binding TranscripcionEditada, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                    <ui:InfoBar
                                        Margin="0,8,0,0"
                                        IsClosable="False"
                                        IsOpen="{Binding ErrorTranscripcion, Converter={StaticResource TextoNoVacio}}"
                                        Message="{Binding ErrorTranscripcion}"
                                        Severity="Warning"
                                        Title="No encaja" />
                                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                        <ui:Button
                                            Appearance="Primary"
                                            Command="{Binding DataContext.ViewModel.GuardarTranscripcionCommand, ElementName=Raiz}"
                                            CommandParameter="{Binding}"
                                            Content="Guardar" />
                                        <ui:Button
                                            Margin="8,0,0,0"
                                            Command="{Binding DataContext.ViewModel.CancelarTranscripcionCommand, ElementName=Raiz}"
                                            CommandParameter="{Binding}"
                                            Content="Cancelar" />
                                    </StackPanel>
                                </StackPanel>

                                <!--  Zona de prueba  -->
                                <Border
                                    Margin="0,12,0,0"
                                    Padding="12"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="6"
                                    Visibility="{Binding MostrarPrueba, Converter={StaticResource BoolAVisibilidad}}">
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,6" Text="Escribe un texto y escúchalo con esta voz:" />
                                        <ui:TextBox AcceptsReturn="True" MinHeight="60" Text="{Binding TextoPrueba, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                            <ComboBox
                                                Margin="0,0,8,0"
                                                MinWidth="140"
                                                DisplayMemberPath="Nombre"
                                                ItemsSource="{Binding DataContext.ViewModel.Motores, ElementName=Raiz}"
                                                SelectedValue="{Binding DataContext.ViewModel.MotorPrueba, ElementName=Raiz}"
                                                SelectedValuePath="Id"
                                                ToolTip="Motor con el que se lee la prueba: escucha el mismo texto con los dos para compararlos"
                                                Visibility="{Binding DataContext.ViewModel.HayVariosMotores, ElementName=Raiz, Converter={StaticResource BoolAVisibilidad}}" />
                                            <ui:Button
                                                Appearance="Primary"
                                                Command="{Binding DataContext.ViewModel.ProbarCommand, ElementName=Raiz}"
                                                CommandParameter="{Binding}"
                                                Content="Generar y escuchar"
                                                IsEnabled="{Binding Generando, Converter={StaticResource NegarBool}}" />
                                            <ui:Button
                                                Margin="8,0,0,0"
                                                Command="{Binding DataContext.ViewModel.EscucharPruebaCommand, ElementName=Raiz}"
                                                CommandParameter="{Binding}"
                                                Content="Volver a escuchar"
                                                Visibility="{Binding UltimaPrueba, Converter={StaticResource NoNuloAVisibilidad}}" />
                                            <ui:ProgressRing
                                                Width="18"
                                                Height="18"
                                                Margin="12,0,0,0"
                                                IsIndeterminate="True"
                                                Visibility="{Binding Generando, Converter={StaticResource BoolAVisibilidad}}" />
                                        </StackPanel>
                                        <TextBlock
                                            Margin="0,8,0,0"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding ResultadoPrueba}"
                                            Visibility="{Binding ResultadoPrueba, Converter={StaticResource NoNuloAVisibilidad}}" />
                                        <ui:InfoBar
                                            Margin="0,8,0,0"
                                            IsClosable="False"
                                            IsOpen="{Binding ErrorPrueba, Converter={StaticResource TextoNoVacio}}"
                                            Message="{Binding ErrorPrueba}"
                                            Severity="Error"
                                            Title="No se ha podido generar" />
                                    </StackPanel>
                                </Border>

                                <!--  Variantes: la misma voz susurrando, asustada…  -->
                                <StackPanel Margin="0,12,0,0" Visibility="{Binding TieneVariantes, Converter={StaticResource BoolAVisibilidad}}">
                                    <TextBlock FontWeight="SemiBold" Text="Variantes" />
                                    <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Variantes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:FilaVariante}">
                                                <Grid Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="160" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding Nombre}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding Detalle}" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <ui:Button
                                                            Appearance="Transparent"
                                                            Command="{Binding DataContext.ViewModel.EscucharVarianteCommand, ElementName=Raiz}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Escuchar la grabación de esta variante">
                                                            <ui:Button.Icon>
                                                                <ui:SymbolIcon Symbol="Play24" />
                                                            </ui:Button.Icon>
                                                        </ui:Button>
                                                        <ui:Button
                                                            Appearance="Transparent"
                                                            Command="{Binding DataContext.ViewModel.BorrarVarianteCommand, ElementName=Raiz}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Borrar esta variante">
                                                            <ui:Button.Icon>
                                                                <ui:SymbolIcon Symbol="Delete24" />
                                                            </ui:Button.Icon>
                                                        </ui:Button>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!--  Añadir una variante  -->
                                <Border
                                    Margin="0,12,0,0"
                                    Padding="12"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="6"
                                    Visibility="{Binding MostrarAnadirVariante, Converter={StaticResource BoolAVisibilidad}}">
                                    <StackPanel>
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="Una variante es la misma voz con otra forma de hablar. En el guion de Narrar se usa con su etiqueta, por ejemplo [whispers] o [asustado], y dura hasta el final de la línea o hasta [normal]."
                                            TextWrapping="Wrap" />
                                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Tipo:" />
                                            <ComboBox
                                                MinWidth="180"
                                                DisplayMemberPath="Nombre"
                                                ItemsSource="{Binding TiposVariante}"
                                                SelectedItem="{Binding TipoVariante}" />
                                        </StackPanel>

                                        <!--  Generar (solo voces diseñadas)  -->
                                        <StackPanel Margin="0,12,0,0" Visibility="{Binding PuedeGenerarVariante, Converter={StaticResource BoolAVisibilidad}}">
                                            <TextBlock
                                                Text="Esta voz es diseñada: Calíope puede generar la variante con su misma descripción y semilla (necesita el modelo VoiceDesign)."
                                                TextWrapping="Wrap" />
                                            <ui:Button
                                                Margin="0,8,0,0"
                                                Appearance="Primary"
                                                Command="{Binding DataContext.ViewModel.GenerarVarianteCommand, ElementName=Raiz}"
                                                CommandParameter="{Binding}"
                                                Content="Generar con VoiceDesign"
                                                IsEnabled="{Binding TrabajandoVariante, Converter={StaticResource NegarBool}}">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Sparkle24" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                            <TextBlock Margin="0,12,0,0" Text="O añádela desde una grabación:" />
                                        </StackPanel>

                                        <!--  Desde una grabación  -->
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox PlaceholderText="Grabación de la misma persona hablando así (5–20 s)" Text="{Binding ArchivoVariante, UpdateSourceTrigger=PropertyChanged}" />
                                            <ui:Button
                                                Grid.Column="1"
                                                Margin="8,0,0,0"
                                                Command="{Binding DataContext.ViewModel.ExaminarVarianteCommand, ElementName=Raiz}"
                                                CommandParameter="{Binding}"
                                                Content="Examinar…" />
                                        </Grid>
                                        <ui:TextBox
                                            Margin="0,8,0,0"
                                            AcceptsReturn="True"
                                            IsEnabled="{Binding SinTranscripcionVariante, Converter={StaticResource NegarBool}}"
                                            MinHeight="50"
                                            PlaceholderText="Transcripción exacta de la grabación"
                                            Text="{Binding TranscripcionVariante, UpdateSourceTrigger=PropertyChanged}"
                                            TextWrapping="Wrap" />
                                        <CheckBox Margin="0,6,0,0" Content="No tengo la transcripción (se imita solo el timbre)" IsChecked="{Binding SinTranscripcionVariante}" />
                                        <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                            <ui:Button
                                                Command="{Binding DataContext.ViewModel.ImportarVarianteCommand, ElementName=Raiz}"
                                                CommandParameter="{Binding}"
                                                Content="Añadir desde la grabación"
                                                IsEnabled="{Binding TrabajandoVariante, Converter={StaticResource NegarBool}}" />
                                            <ui:Button
                                                Margin="8,0,0,0"
                                                Command="{Binding DataContext.ViewModel.AlternarVarianteCommand, ElementName=Raiz}"
                                                CommandParameter="{Binding}"
                                                Content="Cancelar" />
                                            <ui:ProgressRing
                                                Width="18"
                                                Height="18"
                                                Margin="12,0,0,0"
                                                IsIndeterminate="True"
                                                Visibility="{Binding TrabajandoVariante, Converter={StaticResource BoolAVisibilidad}}" />
                                        </StackPanel>
                                        <ui:InfoBar
                                            Margin="0,8,0,0"
                                            IsClosable="False"
                                            IsOpen="{Binding ErrorVariante, Converter={StaticResource TextoNoVacio}}"
                                            Message="{Binding ErrorVariante}"
                                            Severity="Warning"
                                            Title="No se ha podido añadir" />
                                    </StackPanel>
                                </Border>

                                <!--  Acciones secundarias  -->
                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                    <ui:Button
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.ViewModel.PredeterminadaCommand, ElementName=Raiz}"
                                        CommandParameter="{Binding}"
                                        Content="Usar por defecto"
                                        Visibility="{Binding EsPredeterminada, Converter={StaticResource BoolInversoAVisibilidad}}" />
                                    <ui:Button
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.ViewModel.EditarNombreCommand, ElementName=Raiz}"
                                        CommandParameter="{Binding}"
                                        Content="Renombrar" />
                                    <ui:Button
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.ViewModel.EditarTranscripcionCommand, ElementName=Raiz}"
                                        CommandParameter="{Binding}"
                                        Content="Editar transcripción" />
                                    <ui:Button
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.ViewModel.AlternarVarianteCommand, ElementName=Raiz}"
                                        CommandParameter="{Binding}"
                                        Content="Añadir variante" />
                                    <ui:Button
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.ViewModel.BorrarCommand, ElementName=Raiz}"
                                        CommandParameter="{Binding}"
                                        Content="Borrar">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Delete24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
