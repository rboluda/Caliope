<Page
    x:Class="Constantino.App.Paginas.PaginaProximamente"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="1040">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon FontSize="28" Symbol="{Binding Icono}" />
                <TextBlock Margin="12,0,0,0" FontSize="28" FontWeight="SemiBold" Text="{Binding Titulo}" />
            </StackPanel>
            <TextBlock
                Margin="0,8,0,16"
                FontSize="15"
                Text="{Binding Descripcion}"
                TextWrapping="Wrap" />
            <ui:Card>
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Qué podrás hacer aquí" />
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Funciones}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4" Orientation="Horizontal">
                                    <ui:SymbolIcon Margin="0,0,8,0" Symbol="CheckmarkCircle24" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,16,0,0" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="Necesita: " /><Run Text="{Binding Necesita, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </ui:Card>
            <ui:InfoBar
                Margin="0,16,0,0"
                IsClosable="False"
                IsOpen="True"
                Message="{Binding Llegada}"
                Severity="Informational"
                Title="En desarrollo" />
        </StackPanel>
    </ScrollViewer>
</Page>
