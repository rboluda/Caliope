<Page
    x:Class="Constantino.App.Paginas.PaginaDisenar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Constantino.App.ViewModels"
    x:Name="Raiz"
    ScrollViewer.CanContentScroll="False"
    Title="Diseñar voz">
    <Page.Resources>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="1180">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Diseñar voz" />
            <TextBlock
                Margin="0,4,0,12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Describe la voz que quieres y Constantino la inventa. Genera varias versiones, escúchalas y guarda la que más te guste en tu biblioteca."
                TextWrapping="Wrap" />

            <ui:InfoBar
                Margin="0,0,0,12"
                IsClosable="False"
                IsOpen="{Binding ViewModel.VoiceDesignInstalado, Converter={StaticResource NegarBool}}"
                Message="Para diseñar voces hace falta el modelo VoiceDesign (unos 4,3 GB). Puedes instalarlo desde Componentes."
                Severity="Warning"
                Title="Falta el modelo VoiceDesign">
                <ui:InfoBar.Content>
                    <ui:Button Command="{Binding ViewModel.IrAComponentesCommand}" Content="Ir a Componentes" />
                </ui:InfoBar.Content>
            </ui:InfoBar>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Descripción  -->
                <StackPanel>
                    <ui:Card>
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="1. ¿Cómo es la voz?" />
                            <TextBlock Style="{StaticResource Etiqueta}" Text="Empezar desde un ejemplo" />
                            <ComboBox DisplayMemberPath="Nombre" ItemsSource="{Binding ViewModel.Ejemplos}" SelectedItem="{Binding ViewModel.Ejemplo}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Etiqueta}" Text="Sexo" />
                                    <ComboBox DisplayMemberPath="Nombre" ItemsSource="{Binding ViewModel.Sexos}" SelectedValue="{Binding ViewModel.Sexo}" SelectedValuePath="Valor" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Etiqueta}">
                                        <Run Text="Edad: " /><Run FontWeight="SemiBold" Text="{Binding ViewModel.Edad, Mode=OneWay, StringFormat={}{0:0} años}" />
                                    </TextBlock>
                                    <Slider IsSnapToTickEnabled="True" Maximum="90" Minimum="15" TickFrequency="5" Value="{Binding ViewModel.Edad}" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Etiqueta}" Text="Timbre" />
                                    <ComboBox DisplayMemberPath="Nombre" ItemsSource="{Binding ViewModel.Timbres}" SelectedValue="{Binding ViewModel.Timbre}" SelectedValuePath="Clave" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Etiqueta}" Text="Textura" />
                                    <ComboBox DisplayMemberPath="Nombre" ItemsSource="{Binding ViewModel.Texturas}" SelectedValue="{Binding ViewModel.Textura}" SelectedValuePath="Clave" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Etiqueta}" Text="Ritmo" />
                                    <ComboBox DisplayMemberPath="Nombre" ItemsSource="{Binding ViewModel.Ritmos}" SelectedValue="{Binding ViewModel.Ritmo}" SelectedValuePath="Clave" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Etiqueta}" Text="Tono" />
                                    <ComboBox DisplayMemberPath="Nombre" ItemsSource="{Binding ViewModel.Tonos}" SelectedValue="{Binding ViewModel.Tono}" SelectedValuePath="Clave" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Etiqueta}" Text="Idioma" />
                                    <ComboBox DisplayMemberPath="Nombre" ItemsSource="{Binding ViewModel.IdiomasDisponibles}" SelectedValue="{Binding ViewModel.Idioma}" SelectedValuePath="Clave" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Visibility="{Binding ViewModel.EsEspanol, Converter={StaticResource BoolAVisibilidad}}">
                                    <TextBlock Style="{StaticResource Etiqueta}" Text="Acento" />
                                    <ComboBox DisplayMemberPath="Nombre" ItemsSource="{Binding ViewModel.Acentos}" SelectedValue="{Binding ViewModel.Acento}" SelectedValuePath="Clave" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource Etiqueta}" Text="Algo más (opcional, mejor en inglés)" />
                            <ui:TextBox PlaceholderText="Por ejemplo: Like a late-night radio host" Text="{Binding ViewModel.Extra, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="2. Descripción para el modelo" TextWrapping="Wrap" />
                                <ui:Button Grid.Column="1" Appearance="Transparent" Command="{Binding ViewModel.RehacerDescripcionCommand}" Content="Rehacer" ToolTip="Volver a escribirla desde las opciones de arriba" />
                            </Grid>
                            <TextBlock
                                Margin="0,4,0,8"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="Se escribe sola en inglés con las opciones de arriba (el modelo la entiende mejor así). Puedes retocarla a mano."
                                TextWrapping="Wrap" />
                            <ui:TextBox AcceptsReturn="True" MinHeight="90" Text="{Binding ViewModel.Instruccion, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Bottom" Style="{StaticResource Etiqueta}" Text="Texto de muestra (será la grabación de referencia de la voz)" TextWrapping="Wrap" />
                                <ui:Button Grid.Column="1" Appearance="Transparent" Command="{Binding ViewModel.RestaurarTextoCommand}" Content="Restaurar" />
                            </Grid>
                            <ui:TextBox AcceptsReturn="True" MinHeight="90" Text="{Binding ViewModel.TextoMuestra, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="Variantes" />
                                <ui:NumberBox Grid.Column="1" Maximum="6" Minimum="1" SmallChange="1" Value="{Binding ViewModel.NumeroVariantes}" />
                                <ui:Button
                                    Grid.Column="2"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    Appearance="Primary"
                                    Command="{Binding ViewModel.GenerarCommand}"
                                    Content="Generar variantes"
                                    IsEnabled="{Binding ViewModel.Libre}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Sparkle24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Visibility="{Binding ViewModel.Generando, Converter={StaticResource BoolAVisibilidad}}">
                                <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" />
                                <ui:Button Margin="12,0,0,0" Command="{Binding ViewModel.CancelarCommand}" Content="Cancelar" />
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0" Text="{Binding ViewModel.Mensaje}" TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding ViewModel.Motor.Descripcion}"
                                TextWrapping="Wrap" />
                            <ui:InfoBar
                                Margin="0,8,0,0"
                                IsClosable="False"
                                IsOpen="{Binding ViewModel.Error, Converter={StaticResource TextoNoVacio}}"
                                Message="{Binding ViewModel.Error}"
                                Severity="Error"
                                Title="No se ha podido generar" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <!--  Variantes  -->
                <ui:Card Grid.Column="2" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="3. Escucha y guarda" />
                        <TextBlock
                            Margin="0,4,0,8"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Cada variante es una voz distinta con la misma descripción. La que guardes quedará en tu biblioteca, lista para narrar."
                            TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding ViewModel.Variantes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:VarianteVoz}">
                                    <Border Margin="0,6" Padding="12" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Titulo}" />
                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detalle}" />
                                                </StackPanel>
                                                <ui:Button
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.ViewModel.EscucharCommand, ElementName=Raiz}"
                                                    CommandParameter="{Binding}"
                                                    Content="Escuchar">
                                                    <ui:Button.Icon>
                                                        <ui:SymbolIcon Symbol="Play24" />
                                                    </ui:Button.Icon>
                                                </ui:Button>
                                            </Grid>
                                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Visibility="{Binding Guardada, Converter={StaticResource NoNuloAVisibilidad}, ConverterParameter=inverso}">
                                                <ui:TextBox MinWidth="200" PlaceholderText="Nombre de la voz" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
                                                <ui:Button
                                                    Margin="8,0,0,0"
                                                    Appearance="Primary"
                                                    Command="{Binding DataContext.ViewModel.GuardarCommand, ElementName=Raiz}"
                                                    CommandParameter="{Binding}"
                                                    Content="Guardar como voz"
                                                    IsEnabled="{Binding Guardando, Converter={StaticResource NegarBool}}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,8,0,0" Visibility="{Binding Guardada, Converter={StaticResource NoNuloAVisibilidad}}">
                                                <TextBlock Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="{Binding Guardada}" TextWrapping="Wrap" />
                                                <ui:Button Margin="0,6,0,0" Command="{Binding DataContext.ViewModel.IrAVocesCommand, ElementName=Raiz}" Content="Ir a Voces" />
                                            </StackPanel>
                                            <ui:InfoBar
                                                Margin="0,8,0,0"
                                                IsClosable="False"
                                                IsOpen="{Binding Error, Converter={StaticResource TextoNoVacio}}"
                                                Message="{Binding Error}"
                                                Severity="Warning"
                                                Title="No se ha podido guardar" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
