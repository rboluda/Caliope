<Page
    x:Class="Constantino.App.Paginas.PaginaDisenar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:Constantino.App.Controles"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Constantino.App.ViewModels"
    x:Name="Raiz"
    ScrollViewer.CanContentScroll="False"
    Title="{l:T 'Diseñar voz'}">
    <Page.Resources>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="1180">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="{l:T 'Diseñar voz'}" />
            <TextBlock
                Margin="0,4,0,12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{l:T 'Describe la voz que quieres y Calíope la inventa. Genera varias versiones, escúchalas y guarda la que más te guste en tu biblioteca.'}"
                TextWrapping="Wrap" />

            <ui:InfoBar
                Margin="0,0,0,12"
                IsClosable="False"
                IsOpen="{Binding ViewModel.VoiceDesignInstalado, Converter={StaticResource NegarBool}}"
                Message="{l:T 'Para diseñar voces hace falta el modelo VoiceDesign (unos 4,3 GB). Puedes instalarlo desde Componentes.'}"
                Severity="Warning"
                Title="{l:T 'Falta el modelo VoiceDesign'}">
                <ui:InfoBar.Content>
                    <ui:Button Command="{Binding ViewModel.IrAComponentesCommand}" Content="{l:T 'Ir a Componentes'}" />
                </ui:InfoBar.Content>
            </ui:InfoBar>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Descripción  -->
                <StackPanel>
                    <ui:Card>
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{l:T '1. ¿Cómo es la voz?'}" />
                            <TextBlock Style="{StaticResource Etiqueta}" Text="{l:T 'Descríbela con tus palabras (opcional)'}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox
                                    MinHeight="60"
                                    AcceptsReturn="True"
                                    PlaceholderText="{l:T 'Por ejemplo: un abuelo gallego que cuenta historias junto al fuego'}"
                                    Text="{Binding ViewModel.DescripcionLibre, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                                    <ui:Button
                                        Command="{Binding ViewModel.DescribirCommand}"
                                        Content="{l:T 'Rellenar con IA'}"
                                        IsEnabled="{Binding ViewModel.Libre}"
                                        ToolTip="{l:T 'La IA de tu ordenador (el traductor con IA, Qwen3-4B en llama.cpp) lee tu descripción y rellena las opciones de abajo'}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Sparkle24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <ui:ProgressRing
                                        Width="18"
                                        Height="18"
                                        Margin="0,8,0,0"
                                        IsIndeterminate="True"
                                        Visibility="{Binding ViewModel.Describiendo, Converter={StaticResource BoolAVisibilidad}}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{l:T 'La IA rellena las opciones de abajo; después puedes cambiarlas. Necesita el traductor con IA.'}"
                                TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Etiqueta}" Text="{l:T 'O empieza desde un ejemplo'}" />
                            <ComboBox DisplayMemberPath="Nombre" ItemsSource="{Binding ViewModel.Ejemplos}" SelectedItem="{Binding ViewModel.Ejemplo}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Etiqueta}" Text="{l:T 'Sexo'}" />
                                    <ComboBox DisplayMemberPath="Nombre" ItemsSource="{Binding ViewModel.Sexos}" SelectedValue="{Binding ViewModel.Sexo}" SelectedValuePath="Valor" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Etiqueta}">
                                        <Run Text="{l:T 'Edad: '}" /><Run FontWeight="SemiBold" Text="{Binding ViewModel.Edad, Mode=OneWay, StringFormat={}{0:0}}" /><Run FontWeight="SemiBold" Text="{l:T ' años'}" />
                                    </TextBlock>
                                    <Slider IsSnapToTickEnabled="True" Maximum="90" Minimum="15" TickFrequency="5" Value="{Binding ViewModel.Edad}" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Etiqueta}" Text="{l:T 'Timbre'}" />
                                    <ComboBox DisplayMemberPath="Nombre" ItemsSource="{Binding ViewModel.Timbres}" SelectedValue="{Binding ViewModel.Timbre}" SelectedValuePath="Clave" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Etiqueta}" Text="{l:T 'Textura'}" />
                                    <ComboBox DisplayMemberPath="Nombre" ItemsSource="{Binding ViewModel.Texturas}" SelectedValue="{Binding ViewModel.Textura}" SelectedValuePath="Clave" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Etiqueta}" Text="{l:T 'Ritmo'}" />
                                    <ComboBox DisplayMemberPath="Nombre" ItemsSource="{Binding ViewModel.Ritmos}" SelectedValue="{Binding ViewModel.Ritmo}" SelectedValuePath="Clave" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Etiqueta}" Text="{l:T 'Tono'}" />
                                    <ComboBox DisplayMemberPath="Nombre" ItemsSource="{Binding ViewModel.Tonos}" SelectedValue="{Binding ViewModel.Tono}" SelectedValuePath="Clave" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Etiqueta}" Text="{l:T 'Idioma'}" />
                                    <ComboBox DisplayMemberPath="Nombre" ItemsSource="{Binding ViewModel.IdiomasDisponibles}" SelectedValue="{Binding ViewModel.Idioma}" SelectedValuePath="Clave" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Visibility="{Binding ViewModel.EsEspanol, Converter={StaticResource BoolAVisibilidad}}">
                                    <TextBlock Style="{StaticResource Etiqueta}" Text="{l:T 'Acento'}" />
                                    <ComboBox DisplayMemberPath="Nombre" ItemsSource="{Binding ViewModel.Acentos}" SelectedValue="{Binding ViewModel.Acento}" SelectedValuePath="Clave" />
                                </StackPanel>
                            </Grid>

                            <!--  Acento de España: el diseñador sesea; el motor castellano pone la pronunciación.  -->
                            <Border
                                Margin="0,12,0,0"
                                Padding="12"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Visibility="{Binding ViewModel.PuedeAcentoEspana, Converter={StaticResource BoolAVisibilidad}}">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding ViewModel.AcentoEspana}" IsEnabled="{Binding ViewModel.MotorCastellanoInstalado}">
                                        <TextBlock FontWeight="SemiBold" Text="{l:T 'Acento de España de doblaje (con el motor castellano)'}" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{l:T 'El diseñador inventa las voces con acento latino (sesea). Con esta opción, cada variante pasa por el motor castellano: conserva su timbre y habla como en el doblaje de cine de España.'}"
                                        TextWrapping="Wrap" />
                                    <Grid Margin="0,8,0,0" Visibility="{Binding ViewModel.MotorCastellanoInstalado, Converter={StaticResource BoolAVisibilidad}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{l:T 'Pronunciación de:'}" />
                                        <ComboBox
                                            Grid.Column="1"
                                            DisplayMemberPath="Nombre"
                                            IsEnabled="{Binding ViewModel.AcentoEspana}"
                                            ItemsSource="{Binding ViewModel.Pronunciaciones}"
                                            SelectedItem="{Binding ViewModel.Pronunciacion}"
                                            ToolTip="{l:T 'La de serie basta. Con una voz tuya de España, el timbre queda un poco más fiel.'}" />
                                    </Grid>
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                        Text="{l:T 'Necesita el motor castellano (Chatterbox): instálalo desde Componentes.'}"
                                        TextWrapping="Wrap"
                                        Visibility="{Binding ViewModel.MotorCastellanoInstalado, Converter={StaticResource BoolInversoAVisibilidad}}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Etiqueta}" Text="{l:T 'Algo más (opcional, mejor en inglés)'}" />
                            <ui:TextBox PlaceholderText="{l:T 'Por ejemplo: Like a late-night radio host'}" Text="{Binding ViewModel.Extra, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Margin="0,12,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="{l:T '2. Descripción para el modelo'}" TextWrapping="Wrap" />
                                <ui:Button Grid.Column="1" Appearance="Transparent" Command="{Binding ViewModel.RehacerDescripcionCommand}" Content="{l:T 'Rehacer'}" ToolTip="{l:T 'Volver a escribirla desde las opciones de arriba'}" />
                            </Grid>
                            <TextBlock
                                Margin="0,4,0,8"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{l:T 'Se escribe sola en inglés con las opciones de arriba (el modelo la entiende mejor así). Puedes retocarla a mano.'}"
                                TextWrapping="Wrap" />
                            <ui:TextBox AcceptsReturn="True" MinHeight="90" Text="{Binding ViewModel.Instruccion, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Bottom" Style="{StaticResource Etiqueta}" Text="{l:T 'Texto de muestra (será la grabación de referencia de la voz)'}" TextWrapping="Wrap" />
                                <ui:Button Grid.Column="1" Appearance="Transparent" Command="{Binding ViewModel.RestaurarTextoCommand}" Content="{l:T 'Restaurar'}" />
                            </Grid>
                            <ui:TextBox AcceptsReturn="True" MinHeight="90" Text="{Binding ViewModel.TextoMuestra, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Text="{l:T 'Variantes'}" />
                                <ui:NumberBox Grid.Column="1" Maximum="6" Minimum="1" SmallChange="1" Value="{Binding ViewModel.NumeroVariantes}" />
                                <ui:Button
                                    Grid.Column="2"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    Appearance="Primary"
                                    Command="{Binding ViewModel.GenerarCommand}"
                                    Content="{l:T 'Generar variantes'}"
                                    IsEnabled="{Binding ViewModel.Libre}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Sparkle24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                            <CheckBox Margin="0,10,0,0" IsChecked="{Binding ViewModel.RehacerSolas}">
                                <TextBlock
                                    Text="{l:T 'Revisar cada variante y rehacer sola la que no encaje: tono distinto del pedido o palabras saltadas (con la transcripción automática, si está instalada)'}"
                                    TextWrapping="Wrap" />
                            </CheckBox>
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Visibility="{Binding ViewModel.Generando, Converter={StaticResource BoolAVisibilidad}}">
                                <ui:ProgressRing Width="18" Height="18" IsIndeterminate="True" />
                                <ui:Button Margin="12,0,0,0" Command="{Binding ViewModel.CancelarCommand}" Content="{l:T 'Cancelar'}" />
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0" Text="{Binding ViewModel.Mensaje}" TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding ViewModel.Motor.Descripcion}"
                                TextWrapping="Wrap" />
                            <ui:InfoBar
                                Margin="0,8,0,0"
                                IsClosable="False"
                                IsOpen="{Binding ViewModel.Error, Converter={StaticResource TextoNoVacio}}"
                                Message="{Binding ViewModel.Error}"
                                Severity="Error"
                                Title="{l:T 'No se ha podido generar'}" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <!--  Variantes  -->
                <ui:Card Grid.Column="2" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{l:T '3. Escucha y guarda'}" />
                        <TextBlock
                            Margin="0,4,0,8"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{l:T 'Cada variante es una voz distinta con la misma descripción. Escucha también «Así sonará al narrar»: es la voz que tendrás al narrar. La que guardes quedará en tu biblioteca.'}"
                            TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding ViewModel.Variantes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:VarianteVoz}">
                                    <Border Margin="0,6" Padding="12" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel Margin="0,0,110,0">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding Titulo}" TextWrapping="Wrap" />
                                                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detalle}" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding Revision}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{Binding Revision, Converter={StaticResource NoNuloAVisibilidad}}" />
                                                </StackPanel>
                                                <ui:Button
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding DataContext.ViewModel.EscucharCommand, ElementName=Raiz}"
                                                    CommandParameter="{Binding}"
                                                    Content="{l:T 'Escuchar'}">
                                                    <ui:Button.Icon>
                                                        <ui:SymbolIcon Symbol="Play24" />
                                                    </ui:Button.Icon>
                                                </ui:Button>
                                            </Grid>
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                Text="{Binding Avisos}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding Avisos, Converter={StaticResource NoNuloAVisibilidad}}" />
                                            <WrapPanel Margin="0,8,0,0">
                                                <ui:Button
                                                    Margin="0,0,8,0"
                                                    Command="{Binding DataContext.ViewModel.NarrarCommand, ElementName=Raiz}"
                                                    CommandParameter="{Binding}"
                                                    Content="{l:T 'Así sonará al narrar'}"
                                                    IsEnabled="{Binding Narrando, Converter={StaticResource NegarBool}}"
                                                    ToolTip="{l:T 'Lee un párrafo de narración con la voz ya clonada, como saldrá en Narrar'}">
                                                    <ui:Button.Icon>
                                                        <ui:SymbolIcon Symbol="BookOpen24" />
                                                    </ui:Button.Icon>
                                                </ui:Button>
                                                <ui:Button
                                                    Margin="0,0,8,0"
                                                    Command="{Binding DataContext.ViewModel.AlternarCambiosCommand, ElementName=Raiz}"
                                                    CommandParameter="{Binding}"
                                                    Content="{l:T 'Más así…'}"
                                                    IsEnabled="{Binding DataContext.ViewModel.Libre, ElementName=Raiz}">
                                                    <ui:Button.Icon>
                                                        <ui:SymbolIcon Symbol="Wand24" />
                                                    </ui:Button.Icon>
                                                </ui:Button>
                                                <ui:ProgressRing
                                                    Width="18"
                                                    Height="18"
                                                    VerticalAlignment="Center"
                                                    IsIndeterminate="True"
                                                    Visibility="{Binding Narrando, Converter={StaticResource BoolAVisibilidad}}" />
                                            </WrapPanel>
                                            <StackPanel Margin="0,8,0,0" Visibility="{Binding MostrarCambios, Converter={StaticResource BoolAVisibilidad}}">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{l:T 'Crea dos voces con la misma semilla y el cambio que elijas, una con un poco y otra con bastante. Salen parecidas, no idénticas.'}"
                                                    TextWrapping="Wrap" />
                                                <ItemsControl ItemsSource="{Binding Cambios}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:CambioDeVariante}">
                                                            <ui:Button
                                                                Margin="0,6,6,0"
                                                                Command="{Binding DataContext.ViewModel.MasAsiCommand, ElementName=Raiz}"
                                                                CommandParameter="{Binding}"
                                                                Content="{Binding Nombre}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Visibility="{Binding Guardada, Converter={StaticResource NoNuloAVisibilidad}, ConverterParameter=inverso}">
                                                <ui:TextBox MinWidth="200" PlaceholderText="{l:T 'Nombre de la voz'}" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" />
                                                <ui:Button
                                                    Margin="8,0,0,0"
                                                    Appearance="Primary"
                                                    Command="{Binding DataContext.ViewModel.GuardarCommand, ElementName=Raiz}"
                                                    CommandParameter="{Binding}"
                                                    Content="{l:T 'Guardar como voz'}"
                                                    IsEnabled="{Binding Guardando, Converter={StaticResource NegarBool}}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,8,0,0" Visibility="{Binding Guardada, Converter={StaticResource NoNuloAVisibilidad}}">
                                                <TextBlock Foreground="{DynamicResource SystemFillColorSuccessBrush}" Text="{Binding Guardada}" TextWrapping="Wrap" />
                                                <ui:Button Margin="0,6,0,0" Command="{Binding DataContext.ViewModel.IrAVocesCommand, ElementName=Raiz}" Content="{l:T 'Ir a Voces'}" />
                                            </StackPanel>
                                            <ui:InfoBar
                                                Margin="0,8,0,0"
                                                IsClosable="False"
                                                IsOpen="{Binding Error, Converter={StaticResource TextoNoVacio}}"
                                                Message="{Binding Error}"
                                                Severity="Warning"
                                                Title="{l:T 'Algo ha fallado'}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ui:Card>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
