<Page
    x:Class="Constantino.App.Paginas.PaginaEspacio"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:Constantino.App.Controles"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="Raiz"
    ScrollViewer.CanContentScroll="False"
    Title="{l:T 'Espacio'}">
    <Page.Resources>
        <Style x:Key="Secundario" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ParaListos" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="1040">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="{l:T 'Espacio'}" />
            <TextBlock
                Margin="0,4,0,16"
                Style="{StaticResource Secundario}"
                Text="{l:T 'Lo que ocupa Calíope en tu disco y cómo liberarlo. Puedes instalar un componente, probarlo y quitarlo cuando ya no lo necesites.'}" />

            <!--  Resumen  -->
            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon VerticalAlignment="Top" FontSize="24" Symbol="HardDrive24" />
                    <StackPanel Grid.Column="1" Margin="14,0,12,0">
                        <TextBlock FontWeight="SemiBold" Text="{Binding ViewModel.Resumen}" TextWrapping="Wrap" />
                        <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Visibility="{Binding ViewModel.Midiendo, Converter={StaticResource BoolAVisibilidad}}">
                            <ui:ProgressRing Width="16" Height="16" IsIndeterminate="True" />
                            <TextBlock Margin="8,0,0,0" Style="{StaticResource Secundario}" Text="{Binding ViewModel.Mensaje}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource ParaListos}" Text="{Binding ViewModel.CarpetaDatos}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <ui:Button Command="{Binding ViewModel.AbrirCommand}" CommandParameter="{Binding ViewModel.CarpetaDatos}" ToolTip="{l:T 'Abrir la carpeta de Calíope'}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Margin="8,0,0,0" Command="{Binding ViewModel.MedirCommand}" Content="{l:T 'Medir de nuevo'}" IsEnabled="{Binding ViewModel.Libre}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="ArrowClockwise24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <ui:InfoBar
                Margin="0,8,0,0"
                IsOpen="{Binding ViewModel.Error, Converter={StaticResource TextoNoVacio}}"
                Message="{Binding ViewModel.Error}"
                Severity="Warning" />

            <!--  Lo interno que se puede borrar sin perder nada  -->
            <ui:Card Margin="0,8,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon VerticalAlignment="Top" FontSize="24" Symbol="Broom24" />
                        <StackPanel Grid.Column="1" Margin="14,0,12,0">
                            <TextBlock FontWeight="SemiBold" Text="{l:T 'Liberar sin perder nada'}" />
                            <TextBlock Style="{StaticResource Secundario}" Text="{Binding ViewModel.LimpiezaSegura}" />
                        </StackPanel>
                        <ui:Button
                            Grid.Column="2"
                            VerticalAlignment="Top"
                            Appearance="Primary"
                            Command="{Binding ViewModel.LimpiarTodoCommand}"
                            Content="{l:T 'Liberar todo esto'}"
                            IsEnabled="{Binding ViewModel.Libre}"
                            Visibility="{Binding ViewModel.HayLimpiezaSegura, Converter={StaticResource BoolAVisibilidad}}" />
                    </Grid>
                    <ItemsControl Margin="38,8,0,0" ItemsSource="{Binding ViewModel.Limpiables}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Nombre}" />
                                        <TextBlock Style="{StaticResource Secundario}" Text="{Binding Descripcion}" />
                                        <TextBlock Style="{StaticResource ParaListos}" Text="{Binding Detalle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Margin="16,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Libera}" />
                                    <ui:Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.ViewModel.LimpiarCommand, ElementName=Raiz}"
                                        CommandParameter="{Binding}"
                                        Content="{l:T 'Borrar'}"
                                        IsEnabled="{Binding HayAlgo}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <!--  Componentes  -->
            <ui:Card Margin="0,8,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon VerticalAlignment="Top" FontSize="24" Symbol="PuzzlePiece24" />
                        <StackPanel Grid.Column="1" Margin="14,0,12,0">
                            <TextBlock FontWeight="SemiBold" Text="{l:T 'Componentes instalados'}" />
                            <TextBlock Style="{StaticResource Secundario}" Text="{l:T 'Si un componente solo lo querías para probar, quítalo: podrás volver a instalarlo cuando quieras. La cifra es lo que se libera de verdad; lo que comparte con otros componentes (como PyTorch) se queda mientras alguno lo use.'}" />
                        </StackPanel>
                        <ui:Button Grid.Column="2" VerticalAlignment="Top" Command="{Binding ViewModel.IrAComponentesCommand}" Content="{l:T 'Ir a Componentes'}" />
                    </Grid>
                    <ItemsControl Margin="38,8,0,0" ItemsSource="{Binding ViewModel.Componentes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Nombre}" />
                                        <TextBlock Style="{StaticResource ParaListos}" Text="{Binding Detalle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Margin="16,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Libera}" />
                                    <ui:Button
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.ViewModel.DesinstalarCommand, ElementName=Raiz}"
                                        CommandParameter="{Binding}"
                                        Content="{l:T 'Desinstalar'}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <!--  Lo del usuario  -->
            <ui:Card Margin="0,8,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon VerticalAlignment="Top" FontSize="24" Symbol="FolderPerson24" />
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock FontWeight="SemiBold" Text="{l:T 'Lo tuyo'}" />
                            <TextBlock Style="{StaticResource Secundario}" Text="{l:T 'Tus narraciones, doblajes, actas y voces, de mayor a menor. Lo que borres de aquí va a la papelera de Windows: si te arrepientes, lo recuperas desde allí. Las voces se quitan desde «Mis voces».'}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        Margin="38,8,0,0"
                        Style="{StaticResource Secundario}"
                        Text="{l:T 'Todavía no tienes narraciones, doblajes, actas ni voces.'}"
                        Visibility="{Binding ViewModel.SinTrabajos, Converter={StaticResource BoolAVisibilidad}}" />
                    <ItemsControl Margin="38,8,0,0" ItemsSource="{Binding ViewModel.Trabajos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Nombre}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource ParaListos}">
                                            <Run Text="{Binding Tipo, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Fecha, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Margin="16,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Ocupa}" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                        <ui:Button
                                            Appearance="Transparent"
                                            Command="{Binding DataContext.ViewModel.AbrirCommand, ElementName=Raiz}"
                                            CommandParameter="{Binding Datos.Ruta}"
                                            ToolTip="{l:T 'Abrir esta carpeta'}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="FolderOpen24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button
                                            Margin="4,0,0,0"
                                            Appearance="Transparent"
                                            Command="{Binding DataContext.ViewModel.APapeleraCommand, ElementName=Raiz}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{l:T 'Mover a la papelera'}"
                                            Visibility="{Binding SePuedeBorrar, Converter={StaticResource BoolAVisibilidad}}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Delete24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button
                                            Margin="4,0,0,0"
                                            Appearance="Transparent"
                                            Command="{Binding DataContext.ViewModel.IrAVocesCommand, ElementName=Raiz}"
                                            ToolTip="{l:T 'Ir a Mis voces'}"
                                            Visibility="{Binding EsVoz, Converter={StaticResource BoolAVisibilidad}}">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="ArrowRight24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
