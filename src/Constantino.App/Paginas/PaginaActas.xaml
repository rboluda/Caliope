<Page
    x:Class="Constantino.App.Paginas.PaginaActas"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:Constantino.App.Controles"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Constantino.App.ViewModels"
    x:Name="Raiz"
    ScrollViewer.CanContentScroll="False"
    Title="{l:T 'Actas de reuniones'}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="1040">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="{l:T 'Actas de reuniones'}" />
            <TextBlock
                Margin="0,4,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{l:T 'Convierte la grabación de una reunión en su acta: Calíope la pasa a texto, distingue a las personas que hablan y redacta los puntos clave, las decisiones y las tareas con una IA en tu ordenador. Nada sale de tu equipo.'}"
                TextWrapping="Wrap" />

            <ui:InfoBar
                Margin="0,0,0,12"
                IsClosable="False"
                IsOpen="{Binding ViewModel.Faltan, Converter={StaticResource TextoNoVacio}}"
                Message="{Binding ViewModel.Faltan}"
                Severity="Warning"
                Title="{l:T 'Falta instalar algo'}" />
            <ui:Button
                Margin="0,0,0,12"
                Command="{Binding ViewModel.IrAComponentesCommand}"
                Content="{l:T 'Ir a Componentes'}"
                Visibility="{Binding ViewModel.Faltan, Converter={StaticResource NoNuloAVisibilidad}}" />

            <!--  Reunión  -->
            <ui:Card>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            DisplayMemberPath="Titulo"
                            IsEnabled="{Binding ViewModel.Libre}"
                            ItemsSource="{Binding ViewModel.Proyectos}"
                            SelectedItem="{Binding ViewModel.ProyectoSeleccionado}"
                            ToolTip="{l:T 'Reunión'}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Margin="8,0,0,0" Appearance="Primary" Command="{Binding ViewModel.NuevaCommand}" Content="{l:T 'Nueva acta…'}" IsEnabled="{Binding ViewModel.Libre}" />
                            <ui:Button Margin="8,0,0,0" Command="{Binding ViewModel.AbrirCarpetaCommand}" IsEnabled="{Binding ViewModel.HayProyecto}" ToolTip="{l:T 'Abrir la carpeta del acta'}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="FolderOpen24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Margin="8,0,0,0" Command="{Binding ViewModel.BorrarCommand}" IsEnabled="{Binding ViewModel.HayProyecto}" ToolTip="{l:T 'Borrar el acta'}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Delete24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding ViewModel.Resumen}"
                        TextWrapping="Wrap"
                        Visibility="{Binding ViewModel.Resumen, Converter={StaticResource NoNuloAVisibilidad}}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{l:T 'Empieza con «Nueva acta…» y elige la grabación (audio o vídeo: del móvil, de una grabadora o de Teams).'}"
                        TextWrapping="Wrap"
                        Visibility="{Binding ViewModel.HayProyecto, Converter={StaticResource BoolInversoAVisibilidad}}" />
                </StackPanel>
            </ui:Card>

            <!--  Datos y acciones  -->
            <ui:Card Margin="0,8,0,0" Visibility="{Binding ViewModel.HayProyecto, Converter={StaticResource BoolAVisibilidad}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="{l:T 'Título'}" />
                            <ui:TextBox IsEnabled="{Binding ViewModel.Libre}" Text="{Binding ViewModel.Titulo, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="{l:T 'Fecha de la reunión'}" />
                            <DatePicker Width="160" IsEnabled="{Binding ViewModel.Libre}" SelectedDate="{Binding ViewModel.Fecha}" ToolTip="{l:T 'Con ella, «la semana que viene» se convierte en una fecha en el acta.'}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="{l:T '¿Cuántas personas hablan?'}" />
                            <ComboBox
                                Width="220"
                                DisplayMemberPath="Texto"
                                IsEnabled="{Binding ViewModel.Libre}"
                                ItemsSource="{Binding ViewModel.OpcionesPersonas}"
                                SelectedItem="{Binding ViewModel.Personas}"
                                ToolTip="{l:T 'Si lo sabes, dilo: Calíope separa mejor las voces cuando sabe cuántas son.'}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,12,0,4" FontWeight="SemiBold" Text="{l:T 'Glosario (opcional)'}" />
                    <ui:TextBox
                        IsEnabled="{Binding ViewModel.Libre}"
                        PlaceholderText="{l:T 'Nombres y términos tal como se escriben, separados por comas: Endress+Hauser, VLAN, Ascensión…'}"
                        Text="{Binding ViewModel.Glosario, UpdateSourceTrigger=LostFocus}"
                        TextWrapping="Wrap" />

                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                        <ui:Button Appearance="Primary" Command="{Binding ViewModel.TranscribirCommand}" IsEnabled="{Binding ViewModel.Libre}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,8,0" Symbol="Mic24" />
                                <TextBlock Text="{l:T 'Transcribir'}" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="8,0,0,0" Appearance="Primary" Command="{Binding ViewModel.RedactarCommand}" IsEnabled="{Binding ViewModel.Libre}" Visibility="{Binding ViewModel.HayTranscripcion, Converter={StaticResource BoolAVisibilidad}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,8,0" Symbol="DocumentText24" />
                                <TextBlock Text="{l:T 'Redactar el acta'}" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button Margin="8,0,0,0" Command="{Binding ViewModel.CancelarCommand}" Content="{l:T 'Cancelar'}" Visibility="{Binding ViewModel.Ocupado, Converter={StaticResource BoolAVisibilidad}}" />
                    </StackPanel>
                    <StackPanel Margin="0,12,0,0" Visibility="{Binding ViewModel.Mensaje, Converter={StaticResource NoNuloAVisibilidad}}">
                        <TextBlock Text="{Binding ViewModel.Mensaje}" TextWrapping="Wrap" />
                        <ProgressBar Height="4" Margin="0,6,0,0" Maximum="1" Visibility="{Binding ViewModel.Ocupado, Converter={StaticResource BoolAVisibilidad}}" Value="{Binding ViewModel.Fraccion, Mode=OneWay}" />
                    </StackPanel>
                    <ui:InfoBar
                        Margin="0,12,0,0"
                        IsClosable="False"
                        IsOpen="{Binding ViewModel.Error, Converter={StaticResource TextoNoVacio}}"
                        Message="{Binding ViewModel.Error}"
                        Severity="Error"
                        Title="{l:T 'No se ha podido hacer el acta'}" />
                    <TextBlock
                        Margin="0,12,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{l:T 'Graba y transcribe reuniones solo si los participantes lo saben y están de acuerdo.'}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <!--  Personas  -->
            <ui:Card Margin="0,8,0,0" Visibility="{Binding ViewModel.HayTranscripcion, Converter={StaticResource BoolAVisibilidad}}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon FontSize="20" Symbol="People24" />
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{l:T 'Quién es quién'}" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,4,0,8"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{l:T 'La IA propone los nombres por lo que se dice en la reunión, pero puede equivocarse: escucha cada voz y corrige. Pon también su empresa o papel, por ejemplo «Raúl (Informática de Azor)». Si dos son la misma persona, únelas.'}"
                        TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding ViewModel.Participantes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FilaParticipante}">
                                <Grid Margin="0,4,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="320" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="14" Height="14" Margin="0,0,10,0" VerticalAlignment="Center" Background="{Binding Color}" CornerRadius="7" />
                                    <ui:TextBox Grid.Column="1" IsEnabled="{Binding DataContext.ViewModel.Libre, ElementName=Raiz}" Text="{Binding Nombre, UpdateSourceTrigger=LostFocus}" />
                                    <ui:Button
                                        Grid.Column="2"
                                        Margin="6,0,0,0"
                                        Command="{Binding DataContext.ViewModel.EscucharParticipanteCommand, ElementName=Raiz}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{l:T 'Escuchar su voz'}">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Play24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <TextBlock Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detalle}" />
                                    <ComboBox
                                        Grid.Column="4"
                                        Width="200"
                                        Margin="8,0,0,0"
                                        DisplayMemberPath="Nombre"
                                        IsEnabled="{Binding DataContext.ViewModel.Libre, ElementName=Raiz}"
                                        ItemsSource="{Binding Otras}"
                                        SelectedItem="{Binding UnirCon}"
                                        ToolTip="{l:T 'Unir con otra persona: si Calíope ha partido a una misma persona en dos.'}"
                                        Visibility="{Binding Otras.Count, Converter={StaticResource NumeroAVisibilidad}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>

            <!--  Acta  -->
            <ui:Card Margin="0,8,0,0" Visibility="{Binding ViewModel.HayActa, Converter={StaticResource BoolAVisibilidad}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon FontSize="20" Symbol="DocumentText24" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{l:T 'El acta'}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Appearance="Primary" Command="{Binding ViewModel.GuardarActaCommand}" Content="{l:T 'Guardar el acta…'}" ToolTip="{l:T 'En Word, Markdown o texto'}" />
                            <ui:Button Margin="8,0,0,0" Command="{Binding ViewModel.CopiarActaCommand}" ToolTip="{l:T 'Copiar el acta'}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Copy24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,4,0,8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:T 'Puedes corregirla aquí mismo: los cambios se guardan solos.'}" TextWrapping="Wrap" />
                    <TextBox
                        MinHeight="200"
                        MaxHeight="640"
                        AcceptsReturn="True"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="13"
                        IsEnabled="{Binding ViewModel.Libre}"
                        Text="{Binding ViewModel.Acta, UpdateSourceTrigger=LostFocus}"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto" />
                </StackPanel>
            </ui:Card>

            <!--  Transcripción  -->
            <Grid Margin="0,16,0,6" Visibility="{Binding ViewModel.HayTranscripcion, Converter={StaticResource BoolAVisibilidad}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="{l:T 'Transcripción'}" />
                <ui:Button Grid.Column="1" Command="{Binding ViewModel.GuardarTranscripcionCommand}" Content="{l:T 'Guardar la transcripción…'}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding ViewModel.Intervenciones}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FilaIntervencion}">
                        <ui:Card Margin="0,0,0,6" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="4" Margin="0,0,10,0" Background="{Binding Color}" CornerRadius="2" />
                                <TextBlock Grid.Column="1" Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Tiempo}" />
                                <StackPanel Grid.Column="2">
                                    <ComboBox
                                        MinWidth="160"
                                        Margin="0,0,0,4"
                                        Padding="8,2"
                                        HorizontalAlignment="Left"
                                        DisplayMemberPath="Nombre"
                                        IsEnabled="{Binding DataContext.ViewModel.Libre, ElementName=Raiz}"
                                        ItemsSource="{Binding DataContext.ViewModel.Participantes, ElementName=Raiz}"
                                        SelectedValue="{Binding Hablante}"
                                        SelectedValuePath="Id"
                                        ToolTip="{l:T 'Quién lo dice'}" />
                                    <ui:TextBox IsEnabled="{Binding DataContext.ViewModel.Libre, ElementName=Raiz}" Text="{Binding Texto, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ui:Button
                                    Grid.Column="3"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Command="{Binding DataContext.ViewModel.EscucharIntervencionCommand, ElementName=Raiz}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{l:T 'Escuchar lo que se dijo'}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Play24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
