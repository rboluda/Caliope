<Page
    x:Class="Constantino.App.Paginas.PaginaAyuda"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:Constantino.App.Controles"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ScrollViewer.CanContentScroll="False"
    Title="{l:T 'Ayuda'}">
    <Page.Resources>
        <Style x:Key="Parrafo" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="21" />
        </Style>
        <Style x:Key="Subtitulo" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,6,0,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Codigo" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,2,16,2" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style x:Key="Celda" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,2" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="1040">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="72" Height="72" Source="pack://application:,,,/Recursos/caliope.png" />
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="{l:T 'Ayuda'}" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Text="{l:T 'Calíope convierte textos en voz en tu propio ordenador: crea voces, clónalas y narra guiones completos sin conexión, sin cuentas y sin pagar por minuto. Es una suite que reúne herramientas de código abierto de terceros (Qwen3-TTS, Chatterbox, VoxCPM2, Whisper, FFmpeg…) y las hace fáciles de usar; los créditos completos están en Ajustes → Acerca de Calíope.'}" />
                </StackPanel>
            </Grid>

            <!--  Primeros pasos  -->
            <ui:CardExpander Margin="0,20,0,0" IsExpanded="True">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="Rocket24" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <TextBlock FontWeight="SemiBold" Text="{l:T 'Primeros pasos'}" />
                </ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T '1. Instala lo necesario. El asistente del primer arranque analiza tu equipo y propone qué instalar. Siempre puedes añadir o quitar piezas desde «Componentes». Lo imprescindible son las herramientas básicas, el motor de voz y una de las voces (la de alta calidad, o la ligera en equipos modestos).'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T '2. Consigue una voz. Puedes diseñarla describiéndola con palabras («Diseñar voz»), clonarla a partir de una grabación tuya o de alguien que te haya dado permiso («Clonar voz»), o importar un audio que ya tengas («Mis voces → Importar una voz»).'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T '3. Narra. En «Narrar» crea un proyecto, escribe o pega el guion, elige la voz y pulsa «Generar narración». Cada párrafo se convierte en un bloque de audio; si cambias algo, solo se rehace lo que ha cambiado.'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T '4. Saca el audio. En la zona «Narración completa» puedes escucharla, guardarla donde quieras, copiarla o arrastrarla directamente a tu editor de vídeo. «Exportar todo…» copia también cada bloque por separado.'}" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Click="AlIrAComponentes" Content="{l:T 'Ir a Componentes'}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="PuzzlePiece24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Margin="8,0,0,0" Click="AlIrANarrar" Content="{l:T 'Ir a Narrar'}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="BookOpen24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>
            </ui:CardExpander>

            <!--  Voces  -->
            <ui:CardExpander Margin="0,8,0,0">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="PersonVoice24" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <TextBlock FontWeight="SemiBold" Text="{l:T 'Voces: diseñar, clonar y variantes'}" />
                </ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource Subtitulo}" Text="{l:T 'Diseñar una voz'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Elige sexo, edad, timbre, ritmo, tono y acento (o escribe la descripción tú mismo). Calíope genera varias versiones con semillas distintas: escúchalas y guarda la que más te guste. Necesita el diseñador de voces.'}" />
                    <TextBlock Style="{StaticResource Subtitulo}" Text="{l:T 'Clonar una voz'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Graba entre 10 y 20 segundos leyendo el texto propuesto (o importa un audio), recorta el tramo bueno y comprueba el análisis: sin saturar, sin ruido de fondo y con volumen suficiente. La transcripción tiene que ser exacta: con la transcripción automática instalada se escribe sola.'}" />
                    <TextBlock Style="{StaticResource Subtitulo}" Text="{l:T 'El tono de la grabación también se copia'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'El motor imita el timbre y también la forma de hablar de la grabación: si es alegre, la narración saldrá alegre. Para una historia de misterio, clona una grabación pausada, grave y algo tensa. Para los momentos distintos (susurros, miedo, gritos), añade variantes.'}" />
                    <TextBlock Style="{StaticResource Subtitulo}" Text="{l:T 'La transcripción importa'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Si la transcripción no coincide con lo que se oye, la voz sale cortada (medio segundo de audio). Calíope avisa cuando no encaja. Si no la tienes, marca «No tengo la transcripción»: se imitará solo el timbre, algo menos parecido pero sin riesgo.'}" />
                    <TextBlock Style="{StaticResource Subtitulo}" Text="{l:T 'Variantes'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Una variante es la misma voz hablando de otra forma: susurrando, tensa, asustada, triste, alegre o gritando. Se añaden en «Mis voces → Añadir variante» desde una grabación o, si la voz es diseñada, generándola con el diseñador de voces. En el guion se usan con su etiqueta.'}" />
                    <TextBlock Style="{StaticResource Subtitulo}" Text="{l:T 'Susurro fabricado'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Si no tienes un susurro grabado, elige «Susurrando» al añadir la variante y pulsa «Fabricar el susurro»: Calíope convierte la grabación de la voz en susurro conservando su timbre (con WORLD). Lo mejor sigue siendo un susurro grabado de verdad de 8 segundos o más; el fabricado suena algo peor, pero mucho mejor que bajar el volumen. Un susurro de menos de 3 segundos no sirve: el motor no llega a susurrar.'}" />
                </StackPanel>
            </ui:CardExpander>

            <!--  Guion  -->
            <ui:CardExpander Margin="0,8,0,0">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="DocumentText24" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <TextBlock FontWeight="SemiBold" Text="{l:T 'Cómo se escribe un guion'}" />
                </ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Escribe el texto tal cual. Cada párrafo (separado por una línea en blanco) es un bloque con su propio archivo de audio. Puedes usar estas marcas:'}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource Codigo}" Text="{l:T '[pause]'}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Celda}" Text="{l:T 'Pausa corta (0,6 s por defecto).'}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource Codigo}" Text="{l:T '[long pause]'}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Celda}" Text="{l:T 'Pausa larga (1,5 s por defecto).'}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource Codigo}" Text="{l:T '[whispers]'}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Celda}" Text="{l:T 'Susurra hasta el final de la línea. Usa la variante «susurro» si la voz la tiene; si no, baja el volumen.'}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource Codigo}" Text="{l:T '[asustado], [tenso]…'}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource Celda}" Text="{l:T 'Lee con esa variante de la voz hasta el final de la línea. En Narrar aparecen botones con las variantes de la voz elegida.'}" />
                        <TextBlock Grid.Row="4" Style="{StaticResource Codigo}" Text="{l:T '[normal]'}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Celda}" Text="{l:T 'Vuelve a la voz normal antes de que acabe la línea.'}" />
                        <TextBlock Grid.Row="5" Style="{StaticResource Codigo}" Text="{l:T '# nombre'}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource Celda}" Text="{l:T 'En la primera línea de un párrafo, da nombre al bloque (y a su archivo).'}" />
                        <TextBlock Grid.Row="6" Style="{StaticResource Codigo}" Text="{l:T '// nota'}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource Celda}" Text="{l:T 'Comentario: no se lee.'}" />
                        <TextBlock Grid.Row="7" Style="{StaticResource Codigo}" Text="{l:T '(línea en blanco)'}" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource Celda}" Text="{l:T 'Separa bloques. Entre bloques hay una pausa que ajustas en «Más ajustes».'}" />
                        <TextBlock Grid.Row="8" Style="{StaticResource Codigo}" Text="{l:T '[voz: Nombre]'}" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource Celda}" Text="{l:T 'Lee con otra voz de tu biblioteca hasta el final de la línea: para diálogos y personajes. [normal] vuelve a la tuya.'}" />
                        <TextBlock Grid.Row="9" Style="{StaticResource Codigo}" Text="{l:T '[sfx: trueno]'}" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource Celda}" Text="{l:T 'Un efecto de sonido de «Mis sonidos», con la voz en pausa mientras suena.'}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Subtitulo}" Text="{l:T 'Ejemplo'}" />
                    <Border Padding="12" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                        <TextBlock FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap"><Run Text="{l:T '# inicio'}" /><LineBreak /><Run Text="{l:T 'Era sábado por la noche. [pause] Diluviaba.'}" /><LineBreak /><LineBreak /><Run Text="{l:T '# susto'}" /><LineBreak /><Run Text="{l:T 'Alguien llamó a la puerta. [long pause]'}" /><LineBreak /><Run Text="{l:T '[whispers] No abras. [normal] Pero ella abrió. [sfx: trueno]'}" /><LineBreak /><Run Text="{l:T '[voz: Anciano] ¿Quién anda ahí?'}" /></TextBlock>
                    </Border>
                </StackPanel>
            </ui:CardExpander>

            <!--  Herramientas del guion  -->
            <ui:CardExpander Margin="0,8,0,0">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="Wand24" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <TextBlock FontWeight="SemiBold" Text="{l:T 'Pronunciación, otras tomas y sonidos'}" />
                </ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource Subtitulo}" Text="{l:T 'Cifras, fechas y abreviaturas'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Con una voz en español, Calíope escribe con palabras lo que los motores leen mal: «1.250 €» se lee «mil doscientos cincuenta euros», «13/11/2026» «trece de noviembre de dos mil veintiséis», «21:30» «veintiuna y media», «3.º piso» «tercer piso», «-5 °C» «menos cinco grados», «Sr.» «señor» y «siglo XIX» «siglo diecinueve». Los números concuerdan con la palabra que les sigue («21 personas», «1 coche»). Si quieres que una cifra se lea de otra forma, escríbela con palabras o añádela a «Pronunciación», que manda sobre esto.'}" />
                    <TextBlock Style="{StaticResource Subtitulo}" Text="{l:T 'Pronunciación'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Si la voz dice mal una palabra (un nombre, una sigla, una palabra extranjera), pulsa «Pronunciación» en Narrar y escribe cómo debe sonar: «ONU» → «o ene u». Sirve para todos tus proyectos.'}" />
                    <TextBlock Style="{StaticResource Subtitulo}" Text="{l:T 'Otras tomas'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Cada vez que se genera un bloque, la voz lo interpreta de una manera. Si no te convence, pulsa el botón de capas del bloque y «Generar 2 tomas»: escúchalas y quédate con la que mejor suene. La anterior no se pierde, queda como otra toma.'}" />
                    <TextBlock Style="{StaticResource Subtitulo}" Text="{l:T 'Revisión automática'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Con la transcripción automática instalada, Calíope escucha cada bloque nuevo y lo compara con el guion. Si la voz se ha saltado o inventado palabras, prueba otras tomas y se queda con la buena; si ninguna lo consigue, te avisa para que lo revises.'}" />
                    <TextBlock Style="{StaticResource Subtitulo}" Text="{l:T 'Sonidos'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'En «Mis sonidos» hay efectos (trueno, latido, reloj…) y ambientes (lluvia, viento, hoguera, noche) creados por Calíope, libres de derechos. Puedes añadir tus propios audios a cada carpeta. La música de fondo la pones tú en la carpeta «Música»: usa solo música con licencia para tu uso.'}" />
                    <TextBlock Style="{StaticResource Subtitulo}" Text="{l:T 'Fondo y duración'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'En «Fondo, duración y revisión» eliges un ambiente o una música para el audio completo: bajan solos cuando habla la voz. Con una duración máxima (59 s para un Short), si el audio se pasa un poco, se acelera sin cambiar el tono para que quepa.'}" />
                </StackPanel>
            </ui:CardExpander>

            <!--  Ajustes de narración  -->
            <ui:CardExpander Margin="0,8,0,0">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="Options24" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <TextBlock FontWeight="SemiBold" Text="{l:T 'Ajustes de la narración'}" />
                </ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Expresividad (no la usa el motor de máximo parecido): cuánta libertad tiene el motor al entonar. Baja, más estable y monótona; alta, más viva pero con más riesgo de errores (palabras raras o repetidas). Si un bloque sale mal, pulsa su botón de regenerar o cambia la semilla.'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Velocidad y tono: se aplican al final, sin que uno afecte al otro. Más allá de un 15 % de velocidad o de 2 semitonos empieza a notarse artificial.'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Intensidad emocional (solo con el motor castellano rápido): cuánto se exagera la emoción. 0,5 es natural; por encima de 0,7 puede sonar teatral.'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Semilla: el mismo texto con la misma semilla sale siempre igual. Cámbiala para obtener otra interpretación.'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Volumen (LUFS): todas las narraciones se igualan a este volumen. −16 es lo habitual en vídeos y pódcast; −14 suena más fuerte.'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Formato: MP3 para usar directamente; WAV si vas a seguir editando el audio.'}" />
                </StackPanel>
            </ui:CardExpander>

            <!--  Actas  -->
            <ui:CardExpander Margin="0,8,0,0">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="DocumentText24" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <TextBlock FontWeight="SemiBold" Text="{l:T 'Actas de reuniones'}" />
                </ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'En «Actas de reuniones» eliges la grabación de una reunión (del móvil, de una grabadora o de Teams) y Calíope la pasa a texto, distingue a las personas que hablan y redacta el acta: puntos clave, decisiones, tareas con responsable y plazo, fechas límite, riesgos y seguimiento. Todo se hace en tu ordenador: la grabación no sale de él.'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Después de transcribir, la IA propone quién es cada persona por lo que se dice («Sí, hola Raúl»). Puede equivocarse: escucha cada voz, corrige los nombres y añade su empresa o papel antes de redactar. Si sabes cuántas personas hablan, indícalo: las separa mejor.'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Con la fecha de la reunión, «la semana que viene» se convierte en una fecha, y con el glosario los nombres y siglas salen bien escritos. Cada punto del acta lleva el minuto en que se dijo, para comprobarlo en la transcripción. El acta se puede corregir en la propia pantalla y guardar en Word, Markdown o texto.'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Hace falta instalar en «Componentes» la transcripción automática, el traductor con IA y una voz del motor principal (su huella de voz distingue a las personas). Graba y transcribe reuniones solo si los participantes lo saben y están de acuerdo.'}" />
                </StackPanel>
            </ui:CardExpander>

            <!--  Doblar  -->
            <ui:CardExpander Margin="0,8,0,0">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="VideoClip24" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <TextBlock FontWeight="SemiBold" Text="{l:T 'Doblar vídeos'}" />
                </ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'En «Doblar vídeos» eliges un vídeo en inglés y Calíope lo devuelve en castellano con la voz de la misma persona: separa la voz de la música y los efectos, transcribe frase a frase, traduce con una IA en tu ordenador y vuelve a decir cada frase. La música y el ambiente originales se conservan.'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Si en el vídeo hablan varias personas (hasta 4), Calíope las distingue solo y dobla a cada una con su voz. En «Personas del vídeo» puedes ponerles nombre, escuchar su voz original y unir dos si las ha separado por error; en cada frase puedes cambiar quién la dice.'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'El timbre sale de la persona del vídeo y la pronunciación, de una voz castellana de «Mis voces» que eliges tú. Si se usara solo la voz original, el resultado tendría un acento inglés muy marcado.'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Cada frase tiene que caber en el tiempo que ocupaba en el vídeo. Si se pasa un poco, se acelera sin cambiar el tono; si se pasa mucho, la IA propone una frase más corta. Puedes corregir cualquier traducción a mano y pulsar otra vez «Doblar vídeo»: solo se rehace lo que has cambiado.'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Hace falta instalar en «Componentes» el motor castellano, la transcripción automática, el separador de voz y el traductor. Vídeos de hasta 10 minutos. Dobla solo vídeos y voces que tengas derecho a usar.'}" />
                </StackPanel>
            </ui:CardExpander>

            <!--  Motores  -->
            <ui:CardExpander Margin="0,8,0,0">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="Server24" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <TextBlock FontWeight="SemiBold" Text="{l:T 'Motores y componentes'}" />
                </ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Qwen3-TTS (Alibaba, licencia Apache 2.0) es el motor principal: clona voces con mucha fidelidad, respeta bien las pausas y es el único que diseña voces (VoiceDesign). El modelo Base 1.7B da la mejor calidad; el 0.6B es para tarjetas de 4 GB o equipos sin tarjeta NVIDIA.'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'El motor principal basta para todo. Los otros dos son opcionales y no hace falta probarlos: en «Componentes», el recuadro «¿Qué motor me conviene?» mira tu tarjeta gráfica y te dice si alguno te aporta algo.'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Castellano rápido (Chatterbox, de Resemble AI, licencia MIT): versión afinada para el castellano de España. Es el más rápido (tarda menos de lo que dura el audio), deja ajustar la intensidad emocional y marca lo que genera con una marca de agua inaudible. Solo lee en español, pide 4,5 GB de tarjeta y todavía no funciona con las RTX 50.'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Máximo parecido (VoxCPM2, de OpenBMB, licencia Apache 2.0): el que más se parece a la voz original, sobre todo si la voz tiene transcripción, y el de mejor sonido (48 kHz). Lee 30 idiomas. Es el más exigente: necesita una tarjeta de 8 GB (con 8 va justo y más lento; mejor 10 GB o más).'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Los tres leen el texto igual de bien. Elige el motor en «Narrar»; en «Mis voces → Probar» puedes escuchar la misma voz con cada uno.'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Whisper (OpenAI, MIT) transcribe las grabaciones al clonar. Es opcional: sin él, escribes la transcripción a mano.'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Solo un motor ocupa la tarjeta gráfica a la vez: al cambiar de motor, Calíope cierra el otro. El motor se enciende solo cuando hace falta y puedes apagarlo para liberar memoria.'}" />
                </StackPanel>
            </ui:CardExpander>

            <!--  Problemas  -->
            <ui:CardExpander Margin="0,8,0,0">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="Wrench24" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <TextBlock FontWeight="SemiBold" Text="{l:T 'Si algo no va bien'}" />
                </ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource Subtitulo}" Text="{l:T 'La voz sale cortada o muy corta'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Casi siempre es la transcripción de la voz: corrígela en «Mis voces → Editar transcripción» o déjala vacía para imitar solo el timbre.'}" />
                    <TextBlock Style="{StaticResource Subtitulo}" Text="{l:T '«No hay memoria suficiente en la tarjeta gráfica»'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Cierra navegadores, juegos y otros programas que usen la tarjeta y vuelve a intentarlo. En equipos de 4 GB usa la «Voz ligera».'}" />
                    <TextBlock Style="{StaticResource Subtitulo}" Text="{l:T 'La primera vez tarda'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Arrancar el motor y cargar el modelo lleva entre 20 y 60 segundos. Después queda en memoria y cada bloque va mucho más rápido.'}" />
                    <TextBlock Style="{StaticResource Subtitulo}" Text="{l:T 'Un componente da errores'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'En «Componentes», pulsa «Reparar»: vuelve a instalarlo aprovechando lo ya descargado. Si quieres verlo, el registro de lo que ha pasado está en «Programas internos», dentro de la carpeta de Calíope (en Ajustes → Almacenamiento ves cada carpeta y lo que ocupa).'}" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button Click="AlAbrirDatos" Content="{l:T 'Abrir la carpeta de datos'}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <ui:Button Margin="8,0,0,0" Click="AlAbrirRegistros" Content="{l:T 'Abrir los registros'}">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="DocumentSearch24" />
                            </ui:Button.Icon>
                        </ui:Button>
                    </StackPanel>
                </StackPanel>
            </ui:CardExpander>

            <!--  Uso responsable  -->
            <ui:CardExpander Margin="0,8,0,0">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="Shield24" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <TextBlock FontWeight="SemiBold" Text="{l:T 'Uso responsable'}" />
                </ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Clona solo tu voz o la de personas que te hayan dado permiso expreso. Por eso Calíope pide confirmar el consentimiento al clonar o importar una voz.'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'No uses voces clonadas para suplantar a nadie, engañar ni difamar. Si publicas contenido con voces sintéticas, indícalo cuando pueda confundir a quien lo escucha.'}" />
                    <TextBlock Style="{StaticResource Parrafo}" Text="{l:T 'Todo se genera en tu equipo: ni los textos ni las voces salen de él. Internet solo se usa para descargar los componentes.'}" />
                </StackPanel>
            </ui:CardExpander>

            <!--  Acerca de  -->
            <ui:CardControl Margin="0,8,0,0">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Info24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{l:T 'Código, novedades y avisos de errores'}" />
                        <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{l:T 'github.com/rboluda/Caliope'}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Click="AlAbrirGitHub" Content="{l:T 'Abrir en el navegador'}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Open24" />
                    </ui:Button.Icon>
                </ui:Button>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
