<Page
    x:Class="Constantino.App.Paginas.PaginaNarrar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:Constantino.App.ViewModels"
    x:Name="Raiz"
    ScrollViewer.CanContentScroll="False"
    Title="Narrar">
    <Page.Resources>
        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="1180">

            <!--  Cabecera y proyecto  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="28" FontWeight="SemiBold" Text="Narrar" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ComboBox
                        MinWidth="260"
                        DisplayMemberPath="Nombre"
                        ItemsSource="{Binding ViewModel.Proyectos}"
                        SelectedItem="{Binding ViewModel.ProyectoSeleccionado}"
                        ToolTip="Proyecto de narración" />
                    <ui:Button Margin="8,0,0,0" Command="{Binding ViewModel.NuevoCommand}" Content="Nuevo proyecto">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Add24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Margin="8,0,0,0" Command="{Binding ViewModel.AbrirCarpetaCommand}" ToolTip="Abrir la carpeta con los audios">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="FolderOpen24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button Margin="8,0,0,0" Command="{Binding ViewModel.BorrarProyectoCommand}" ToolTip="Borrar el proyecto">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Delete24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
            <TextBlock
                Margin="0,4,0,12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Escribe el guion, elige la voz y genera. Cada párrafo es un bloque con su propio audio; al cambiar algo solo se regenera lo que ha cambiado."
                TextWrapping="Wrap" />

            <ui:Card Margin="0,0,0,12" Visibility="{Binding ViewModel.MostrarNuevo, Converter={StaticResource BoolAVisibilidad}}">
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox MinWidth="320" PlaceholderText="Nombre del proyecto (p. ej. La cazadora)" Text="{Binding ViewModel.NombreNuevo, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Margin="8,0,0,0" Appearance="Primary" Command="{Binding ViewModel.CrearProyectoCommand}" Content="Crear" />
                    <ui:Button Margin="8,0,0,0" Command="{Binding ViewModel.CancelarNuevoCommand}" Content="Cancelar" />
                </StackPanel>
            </ui:Card>

            <ui:Card Visibility="{Binding ViewModel.HayProyecto, Converter={StaticResource BoolInversoAVisibilidad}}">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Text="Todavía no tienes proyectos" />
                    <TextBlock Margin="0,6,0,0" Text="Crea uno con «Nuevo proyecto»: empezará con un guion de ejemplo que te enseña las etiquetas." TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <ui:InfoBar
                Margin="0,0,0,12"
                IsClosable="False"
                IsOpen="{Binding ViewModel.SinVoces}"
                Message="Para narrar hace falta al menos una voz. Añádela en «Voces»."
                Severity="Warning"
                Title="No hay voces" />

            <Grid Visibility="{Binding ViewModel.HayProyecto, Converter={StaticResource BoolAVisibilidad}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!--  Editor  -->
                <ui:Card VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <ui:Button Click="AlInsertar" Content="Pausa" Tag="[pause] " ToolTip="Pausa corta [pause]" />
                            <ui:Button Margin="6,0,0,0" Click="AlInsertar" Content="Pausa larga" Tag="[long pause] " ToolTip="Pausa larga [long pause]" />
                            <ui:Button Margin="6,0,0,0" Click="AlInsertar" Content="Susurro" Tag="[whispers] " ToolTip="Susurra hasta el final de la línea [whispers]" />
                            <ui:Button Margin="6,0,0,0" Click="AlInsertarBloque" Content="Nuevo bloque" ToolTip="Empieza un párrafo nuevo con nombre" />
                            <ui:Button
                                Margin="6,0,0,0"
                                Command="{Binding ViewModel.AlternarDiccionarioCommand}"
                                Content="Pronunciación"
                                ToolTip="Palabras que la voz dice mal: escribe cómo deben sonar">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="BookLetter24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ItemsControl ItemsSource="{Binding ViewModel.EtiquetasVoz}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Button
                                            Margin="6,0,0,0"
                                            Appearance="Secondary"
                                            Click="AlInsertar"
                                            Content="{Binding Nombre}"
                                            Tag="{Binding Etiqueta}"
                                            ToolTip="{Binding Etiqueta}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <WrapPanel Margin="0,0,0,8" Visibility="{Binding ViewModel.OtrasVoces.Count, Converter={StaticResource NumeroAVisibilidad}}">
                                <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Otra voz:" />
                                <ItemsControl ItemsSource="{Binding ViewModel.OtrasVoces}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Button Margin="4,0,0,0" Appearance="Transparent" Click="AlInsertar" Content="{Binding Nombre}" Tag="{Binding Etiqueta}"
                                                       ToolTip="Lee con esta voz hasta el final de la línea ([normal] vuelve a la tuya)" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,8" Visibility="{Binding ViewModel.Efectos.Count, Converter={StaticResource NumeroAVisibilidad}}">
                                <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="Efecto:" />
                                <ItemsControl ItemsSource="{Binding ViewModel.Efectos}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Button Margin="4,0,0,0" Appearance="Transparent" Click="AlInsertar" Content="{Binding Nombre}" Tag="{Binding Etiqueta}"
                                                       ToolTip="Suena en ese punto, con la voz en pausa" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>

                            <!--  Diccionario de pronunciación  -->
                            <Border
                                Margin="0,0,0,8"
                                Padding="12"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                CornerRadius="6"
                                Visibility="{Binding ViewModel.MostrarDiccionario, Converter={StaticResource BoolAVisibilidad}}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Pronunciación" />
                                    <TextBlock
                                        Margin="0,2,0,8"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="Si la voz dice mal una palabra (un nombre, una sigla…), escribe cómo debe sonar. Sirve para todos tus proyectos y se guarda solo."
                                        TextWrapping="Wrap" />
                                    <ItemsControl ItemsSource="{Binding ViewModel.Diccionario}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBox PlaceholderText="Se escribe (p. ej. ONU)" Text="{Binding Escrito, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Text="→" />
                                                    <ui:TextBox Grid.Column="2" PlaceholderText="Suena (p. ej. o ene u)" Text="{Binding Dicho, UpdateSourceTrigger=PropertyChanged}" />
                                                    <ui:Button
                                                        Grid.Column="3"
                                                        Margin="6,0,0,0"
                                                        Appearance="Transparent"
                                                        Command="{Binding DataContext.ViewModel.QuitarPronunciacionCommand, ElementName=Raiz}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Quitar">
                                                        <ui:Button.Icon>
                                                            <ui:SymbolIcon Symbol="Delete24" />
                                                        </ui:Button.Icon>
                                                    </ui:Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ui:Button Command="{Binding ViewModel.AnadirPronunciacionCommand}" Content="Añadir palabra">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Add24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock
                            DockPanel.Dock="Bottom"
                            Margin="0,8,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding ViewModel.AyudaVariantes}"
                            TextWrapping="Wrap"
                            Visibility="{Binding ViewModel.AyudaVariantes, Converter={StaticResource NoNuloAVisibilidad}}" />
                        <TextBox
                            x:Name="Editor"
                            MinHeight="380"
                            MaxHeight="520"
                            AcceptsReturn="True"
                            AcceptsTab="True"
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="14"
                            HorizontalScrollBarVisibility="Disabled"
                            Text="{Binding ViewModel.TextoGuion, UpdateSourceTrigger=PropertyChanged}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </DockPanel>
                </ui:Card>

                <!--  Ajustes y generar  -->
                <StackPanel Grid.Column="2">
                    <ui:Card>
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Voz y ajustes" />
                            <TextBlock Style="{StaticResource Etiqueta}" Text="Voz" />
                            <ComboBox DisplayMemberPath="Nombre" ItemsSource="{Binding ViewModel.Voces}" SelectedValue="{Binding ViewModel.VozId}" SelectedValuePath="Id" />

                            <TextBlock Style="{StaticResource Etiqueta}" Text="Motor" />
                            <ComboBox
                                DisplayMemberPath="Nombre"
                                ItemsSource="{Binding ViewModel.Motores}"
                                SelectedValue="{Binding ViewModel.MotorVoz}"
                                SelectedValuePath="Id"
                                ToolTip="Qwen3-TTS hace más pausas y es más fiel; Chatterbox lee más seguido y deja ajustar la emoción." />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding ViewModel.AyudaMotor}"
                                TextWrapping="Wrap"
                                Visibility="{Binding ViewModel.AyudaMotor, Converter={StaticResource NoNuloAVisibilidad}}" />

                            <StackPanel Visibility="{Binding ViewModel.EsChatterbox, Converter={StaticResource BoolAVisibilidad}}">
                                <TextBlock Style="{StaticResource Etiqueta}">
                                    <Run Text="Intensidad emocional: " /><Run FontWeight="SemiBold" Text="{Binding ViewModel.TextoIntensidad, Mode=OneWay}" />
                                </TextBlock>
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    Maximum="1"
                                    Minimum="0.25"
                                    TickFrequency="0.05"
                                    ToolTip="Cuánto se exagera la emoción al leer. Por encima de 0,7 puede sonar teatral."
                                    Value="{Binding ViewModel.Intensidad}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource Etiqueta}">
                                <Run Text="Expresividad: " /><Run FontWeight="SemiBold" Text="{Binding ViewModel.TextoExpresividad, Mode=OneWay}" />
                            </TextBlock>
                            <Slider
                                IsSnapToTickEnabled="True"
                                Maximum="1.2"
                                Minimum="0.5"
                                TickFrequency="0.05"
                                Value="{Binding ViewModel.Temperatura}" />

                            <TextBlock Style="{StaticResource Etiqueta}">
                                <Run Text="Velocidad: " /><Run FontWeight="SemiBold" Text="{Binding ViewModel.TextoVelocidad, Mode=OneWay}" />
                            </TextBlock>
                            <Slider
                                IsSnapToTickEnabled="True"
                                Maximum="1.2"
                                Minimum="0.8"
                                TickFrequency="0.05"
                                ToolTip="Más lenta o más rápida sin cambiar el tono. Más allá de ±15 % empieza a notarse."
                                Value="{Binding ViewModel.Velocidad}" />

                            <TextBlock Style="{StaticResource Etiqueta}">
                                <Run Text="Tono: " /><Run FontWeight="SemiBold" Text="{Binding ViewModel.TextoTono, Mode=OneWay}" />
                            </TextBlock>
                            <Slider
                                IsSnapToTickEnabled="True"
                                Maximum="3"
                                Minimum="-3"
                                TickFrequency="0.5"
                                ToolTip="Más grave o más aguda sin cambiar la velocidad."
                                Value="{Binding ViewModel.TonoSemitonos}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Etiqueta}" Text="Pausa corta (s)" />
                                    <ui:NumberBox Maximum="5" Minimum="0" SmallChange="0.1" Value="{Binding ViewModel.Pausa}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Etiqueta}" Text="Pausa larga (s)" />
                                    <ui:NumberBox Maximum="10" Minimum="0" SmallChange="0.1" Value="{Binding ViewModel.PausaLarga}" />
                                </StackPanel>
                            </Grid>

                            <Expander Margin="0,10,0,0" Header="Más ajustes">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Etiqueta}" Text="Silencio entre bloques en el audio completo (s)" />
                                    <ui:NumberBox Maximum="10" Minimum="0" SmallChange="0.1" Value="{Binding ViewModel.PausaEntreBloques}" />
                                    <TextBlock Style="{StaticResource Etiqueta}" Text="Volumen del susurro (dB respecto a la voz normal)" />
                                    <ui:NumberBox Maximum="0" Minimum="-30" SmallChange="1" Value="{Binding ViewModel.SusurroDb}" />
                                    <TextBlock Style="{StaticResource Etiqueta}" Text="Volumen final (LUFS; −16 es lo habitual en YouTube)" />
                                    <ui:NumberBox Maximum="-8" Minimum="-30" SmallChange="1" Value="{Binding ViewModel.Lufs}" />
                                    <TextBlock Style="{StaticResource Etiqueta}" Text="Semilla (otra semilla, otra forma de decirlo)" />
                                    <ui:NumberBox Maximum="999999" Minimum="0" SmallChange="1" Value="{Binding ViewModel.Semilla}" />
                                    <TextBlock Style="{StaticResource Etiqueta}" Text="Formato" />
                                    <ComboBox DisplayMemberPath="Nombre" ItemsSource="{Binding ViewModel.Formatos}" SelectedValue="{Binding ViewModel.Formato}" SelectedValuePath="Valor" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ui:Card>

                    <ui:Card Margin="0,12,0,0">
                        <StackPanel>
                            <ui:Button
                                HorizontalAlignment="Stretch"
                                Appearance="Primary"
                                Command="{Binding ViewModel.GenerarCommand}"
                                Content="Generar narración"
                                IsEnabled="{Binding ViewModel.Libre}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="PlayCircle24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <StackPanel Margin="0,10,0,0" Visibility="{Binding ViewModel.Generando, Converter={StaticResource BoolAVisibilidad}}">
                                <ProgressBar Height="6" Maximum="1" Value="{Binding ViewModel.Fraccion, Mode=OneWay}" />
                                <ui:Button Margin="0,8,0,0" Command="{Binding ViewModel.CancelarCommand}" Content="Cancelar" />
                            </StackPanel>
                            <TextBlock Margin="0,8,0,0" Text="{Binding ViewModel.Mensaje}" TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding ViewModel.Motor.Descripcion}"
                                TextWrapping="Wrap" />
                            <ui:InfoBar
                                Margin="0,8,0,0"
                                IsClosable="False"
                                IsOpen="{Binding ViewModel.Error, Converter={StaticResource TextoNoVacio}}"
                                Message="{Binding ViewModel.Error}"
                                Severity="Error"
                                Title="No se ha podido narrar" />
                        </StackPanel>
                    </ui:Card>
                </StackPanel>
            </Grid>

            <!--  Bloques  -->
            <ui:Card Margin="0,12,0,0" Visibility="{Binding ViewModel.HayProyecto, Converter={StaticResource BoolAVisibilidad}}">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Bloques" />
                            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding ViewModel.Resumen}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <ui:Button Command="{Binding ViewModel.ExportarTodoCommand}" Content="Exportar todo…" ToolTip="Copia la narración completa y cada bloque a la carpeta que elijas">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowExportLtr24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button Margin="6,0,0,0" Command="{Binding ViewModel.AbrirCarpetaCommand}" Content="Abrir carpeta" ToolTip="{Binding ViewModel.Salida}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="FolderOpen24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </Grid>

                    <!--  Narración completa: el audio que normalmente se quiere sacar  -->
                    <Border
                        Margin="0,12,0,0"
                        Padding="14,10"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Cursor="Hand"
                        MouseMove="AlArrastrarAudio"
                        PreviewMouseLeftButtonDown="AlPulsarAudio"
                        Tag="{Binding ViewModel.Completo}"
                        ToolTip="Arrástralo a tu editor de vídeo o a una carpeta"
                        Visibility="{Binding ViewModel.Completo, Converter={StaticResource NoNuloAVisibilidad}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon VerticalAlignment="Center" FontSize="28" Symbol="MusicNote224" />
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="Narración completa" />
                                <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <Run Text="{Binding ViewModel.NombreCompleto, Mode=OneWay}" /><Run Text=" · arrástralo a tu editor o a una carpeta" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                <ui:Button Command="{Binding ViewModel.EscucharCompletoCommand}" Content="Escuchar">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Play24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Margin="6,0,0,0" Command="{Binding ViewModel.CopiarCompletoCommand}" ToolTip="Copiar el archivo para pegarlo en una carpeta o en el editor">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Copy24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Margin="6,0,0,0" Appearance="Primary" Command="{Binding ViewModel.GuardarCompletoComoCommand}" Content="Guardar como…">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Save24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding ViewModel.AvisoSalida}"
                        TextWrapping="Wrap"
                        Visibility="{Binding ViewModel.AvisoSalida, Converter={StaticResource NoNuloAVisibilidad}}" />
                    <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap">
                        <Run Text="Los audios se guardan en " /><Run Text="{Binding ViewModel.Salida, Mode=OneWay}" /><Run Text=". Cada bloque también se puede arrastrar, guardar o copiar por separado (clic derecho para más opciones)." />
                    </TextBlock>
                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding ViewModel.Bloques}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FilaBloque}">
                                <Border
                                    Margin="0,4"
                                    Padding="12,8"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    CornerRadius="6"
                                    MouseMove="AlArrastrarAudio"
                                    PreviewMouseLeftButtonDown="AlPulsarAudio"
                                    Tag="{Binding Archivo}">
                                    <Border.ContextMenu>
                                        <ContextMenu IsEnabled="{Binding Escuchable}">
                                            <MenuItem Click="AlGuardarBloque" Header="Guardar como…" />
                                            <MenuItem Click="AlCopiarBloque" Header="Copiar" />
                                            <MenuItem Click="AlMostrarBloque" Header="Mostrar en la carpeta" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Titulo}" />
                                                <ui:Badge Margin="10,0,0,0" Appearance="{Binding Apariencia}" Content="{Binding Etiqueta}" />
                                                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Duracion}" />
                                            </StackPanel>
                                            <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Resumen}" TextWrapping="Wrap" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                Text="{Binding Avisos}"
                                                TextWrapping="Wrap"
                                                Visibility="{Binding Avisos, Converter={StaticResource NoNuloAVisibilidad}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                            <ui:Button
                                                Command="{Binding DataContext.ViewModel.EscucharCommand, ElementName=Raiz}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding Escuchable}"
                                                ToolTip="Escuchar este bloque">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Play24" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                            <ui:Button
                                                Margin="6,0,0,0"
                                                Command="{Binding DataContext.ViewModel.GuardarBloqueComoCommand, ElementName=Raiz}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding Escuchable}"
                                                ToolTip="Guardar el audio de este bloque como…">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Save24" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                            <ui:Button
                                                Margin="6,0,0,0"
                                                Command="{Binding DataContext.ViewModel.RegenerarCommand, ElementName=Raiz}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding DataContext.ViewModel.Libre, ElementName=Raiz}"
                                                ToolTip="Volver a generar solo este bloque">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                            <ui:Button
                                                Margin="6,0,0,0"
                                                Command="{Binding DataContext.ViewModel.OtrasTomasCommand, ElementName=Raiz}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Otras tomas: escucha versiones distintas de este bloque y quédate con la mejor">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Symbol="Layer24" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Grid.Row="1" Margin="0,8,0,0" Visibility="{Binding MostrarTomas, Converter={StaticResource BoolAVisibilidad}}">
                                        <Separator Margin="0,0,0,8" />
                                        <TextBlock
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="Cada toma lee el mismo texto con otra interpretación. Escúchalas y quédate con la que mejor suene: la actual se guarda como una toma más."
                                            TextWrapping="Wrap" />
                                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Tomas}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,2" Orientation="Horizontal">
                                                        <TextBlock Width="70" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Titulo}" />
                                                        <TextBlock Width="60" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Duracion}" />
                                                        <ui:Button
                                                            Command="{Binding DataContext.ViewModel.EscucharTomaCommand, ElementName=Raiz}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Escuchar esta toma">
                                                            <ui:Button.Icon>
                                                                <ui:SymbolIcon Symbol="Play24" />
                                                            </ui:Button.Icon>
                                                        </ui:Button>
                                                        <ui:Button
                                                            Margin="6,0,0,0"
                                                            Command="{Binding DataContext.ViewModel.UsarTomaCommand, ElementName=Raiz}"
                                                            CommandParameter="{Binding}"
                                                            Content="Usar esta"
                                                            IsEnabled="{Binding DataContext.ViewModel.Libre, ElementName=Raiz}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding MensajeTomas}"
                                            Visibility="{Binding MensajeTomas, Converter={StaticResource NoNuloAVisibilidad}}" />
                                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                            <ui:Button
                                                Appearance="Primary"
                                                Command="{Binding DataContext.ViewModel.GenerarTomasCommand, ElementName=Raiz}"
                                                CommandParameter="{Binding}"
                                                Content="Generar 2 tomas"
                                                IsEnabled="{Binding DataContext.ViewModel.Libre, ElementName=Raiz}" />
                                            <ui:ProgressRing
                                                Width="18"
                                                Height="18"
                                                Margin="12,0,0,0"
                                                IsIndeterminate="True"
                                                Visibility="{Binding GenerandoTomas, Converter={StaticResource BoolAVisibilidad}}" />
                                        </StackPanel>
                                    </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
