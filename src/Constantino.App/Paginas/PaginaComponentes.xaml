<Page
    x:Class="Constantino.App.Paginas.PaginaComponentes"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l="clr-namespace:Constantino.App.Controles"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    ScrollViewer.CanContentScroll="False"
    xmlns:controles="clr-namespace:Constantino.App.Controles"
    xmlns:vm="clr-namespace:Constantino.App.ViewModels"
    x:Name="Raiz"
    Title="{l:T 'Componentes'}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="1040">
            <Grid>
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="{l:T 'Componentes'}" />
                <ui:Button HorizontalAlignment="Right" Command="{Binding ViewModel.AbrirAsistenteCommand}" Content="{l:T 'Abrir el asistente'}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Wrench24" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>
            <TextBlock
                Margin="0,4,0,4"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{l:T 'Todo lo que Calíope puede instalar. Instala solo lo que vayas a usar: puedes añadir o quitar componentes cuando quieras.'}"
                TextWrapping="Wrap" />
            <TextBlock Margin="0,0,0,8" Text="{Binding ViewModel.ResumenDispositivo}" TextWrapping="Wrap" />

            <controles:PanelInstalacion
                Margin="0,0,0,8"
                DataContext="{Binding ViewModel.Instalacion}"
                Visibility="{Binding DataContext.ViewModel.MostrarProgreso, ElementName=Raiz, Converter={StaticResource BoolAVisibilidad}}" />

            <ui:InfoBar
                Margin="0,0,0,8"
                IsClosable="False"
                IsOpen="{Binding ViewModel.Aviso, Converter={StaticResource TextoNoVacio}}"
                Message="{Binding ViewModel.Aviso}"
                Severity="Warning"
                Title="{l:T 'No se ha podido desinstalar'}" />

            <ui:ProgressRing
                Width="24"
                Height="24"
                HorizontalAlignment="Left"
                IsIndeterminate="True"
                Visibility="{Binding ViewModel.Cargando, Converter={StaticResource BoolAVisibilidad}}" />

            <ItemsControl ItemsSource="{Binding ViewModel.Grupos}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Margin="0,0,0,8" FontSize="18" FontWeight="SemiBold" Text="{Binding Nombre}" />

                            <!--  Guía de motores: qué conviene a este equipo y en qué se diferencian  -->
                            <ui:Card Margin="0,0,0,8" Visibility="{Binding Guia, Converter={StaticResource NoNuloAVisibilidad}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon FontSize="20" Symbol="Lightbulb24" />
                                        <TextBlock Margin="8,0,0,0" FontSize="15" FontWeight="SemiBold" Text="{l:T '¿Qué motor me conviene?'}" />
                                    </StackPanel>
                                    <TextBlock Margin="0,8,0,0" Text="{Binding Guia.Consejo}" TextWrapping="Wrap" />
                                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Guia.Fichas}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Margin="0,0,8,0"
                                                    Padding="12,10"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    CornerRadius="6">
                                                    <StackPanel>
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Nombre}" TextWrapping="Wrap" />
                                                        <TextBlock Margin="0,4,0,6" Text="{Binding ParaQue}" TextWrapping="Wrap" />
                                                        <TextBlock FontSize="12" TextWrapping="Wrap">
                                                            <Run FontWeight="SemiBold" Text="{l:T 'Velocidad: '}" /><Run Text="{Binding Velocidad, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock FontSize="12" TextWrapping="Wrap">
                                                            <Run FontWeight="SemiBold" Text="{l:T 'Parecido a la voz: '}" /><Run Text="{Binding Parecido, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock FontSize="12" TextWrapping="Wrap">
                                                            <Run FontWeight="SemiBold" Text="{l:T 'Idiomas: '}" /><Run Text="{Binding Idiomas, Mode=OneWay}" />
                                                        </TextBlock>
                                                        <TextBlock FontSize="12" TextWrapping="Wrap">
                                                            <Run FontWeight="SemiBold" Text="{l:T 'Tarjeta: '}" /><Run Text="{Binding Tarjeta, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{l:T 'Los tres leen el texto igual de bien: en las pruebas, ninguno se comió ni cambió más de 3 palabras. Medido con la misma voz y el mismo texto en una tarjeta de 8 GB.'}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </ui:Card>

                            <ItemsControl ItemsSource="{Binding Tarjetas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TarjetaComponente}">
                                        <ui:Card Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Nombre}" />
                                                        <ui:Badge Margin="12,0,0,0" Appearance="{Binding Apariencia}" Content="{Binding Etiqueta}" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,6,0,0" Text="{Binding Resumen}" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        FontStyle="Italic"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding Motivo}"
                                                        TextWrapping="Wrap" />
                                                    <Border
                                                        Margin="0,8,0,0"
                                                        Padding="10,6"
                                                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                        CornerRadius="4"
                                                        Visibility="{Binding Consejo, Converter={StaticResource NoNuloAVisibilidad}}">
                                                        <TextBlock TextWrapping="Wrap">
                                                            <Run FontWeight="SemiBold" Text="{l:T '¿Lo necesito? '}" /><Run Text="{Binding Consejo, Mode=OneWay}" />
                                                        </TextBlock>
                                                    </Border>
                                                    <Expander Margin="0,8,0,0" Header="{l:T 'Más información'}">
                                                        <StackPanel Margin="0,8,0,0">
                                                            <TextBlock Text="{Binding Detalle}" TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                                                                <Run FontWeight="SemiBold" Text="{l:T 'Sirve para: '}" /><Run Text="{Binding Habilita, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                                                                <Run FontWeight="SemiBold" Text="{l:T 'Necesita: '}" /><Run Text="{Binding Necesita, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <TextBlock
                                                                Margin="0,8,0,0"
                                                                FontSize="12"
                                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                TextWrapping="Wrap"
                                                                Visibility="{Binding Tecnico, Converter={StaticResource NoNuloAVisibilidad}}">
                                                                <Run FontWeight="SemiBold" Text="{l:T 'Detalles técnicos: '}" /><Run Text="{Binding Tecnico, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="{l:T 'Licencias:'}" />
                                                            <ItemsControl ItemsSource="{Binding Licencias}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <ui:HyperlinkButton Padding="0,2" Content="{Binding Nombre}" NavigateUri="{Binding Url}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Margin="24,0,0,0" MinWidth="150" HorizontalAlignment="Right">
                                                    <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding Tamano}" />
                                                    <TextBlock HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Estado}" />
                                                    <TextBlock
                                                        MaxWidth="180"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Right"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                        Text="{Binding DisponibleEn}"
                                                        TextAlignment="Right"
                                                        TextWrapping="Wrap"
                                                        Visibility="{Binding DisponibleEn, Converter={StaticResource NoNuloAVisibilidad}}" />
                                                    <StackPanel Margin="0,12,0,0" HorizontalAlignment="Right" IsEnabled="{Binding DataContext.ViewModel.Instalacion.Ocupado, ElementName=Raiz, Converter={StaticResource NegarBool}}">
                                                        <ui:Button
                                                            HorizontalAlignment="Right"
                                                            Appearance="Primary"
                                                            Command="{Binding DataContext.ViewModel.InstalarCommand, ElementName=Raiz}"
                                                            CommandParameter="{Binding}"
                                                            Content="{Binding TextoInstalar}"
                                                            Visibility="{Binding PuedeInstalar, Converter={StaticResource BoolAVisibilidad}}">
                                                            <ui:Button.Icon>
                                                                <ui:SymbolIcon Symbol="ArrowDownload24" />
                                                            </ui:Button.Icon>
                                                        </ui:Button>
                                                        <ui:Button
                                                            Margin="0,6,0,0"
                                                            HorizontalAlignment="Right"
                                                            Command="{Binding DataContext.ViewModel.RepararCommand, ElementName=Raiz}"
                                                            CommandParameter="{Binding}"
                                                            Content="{l:T 'Reparar'}"
                                                            Visibility="{Binding PuedeReparar, Converter={StaticResource BoolAVisibilidad}}">
                                                            <ui:Button.Icon>
                                                                <ui:SymbolIcon Symbol="Wrench24" />
                                                            </ui:Button.Icon>
                                                        </ui:Button>
                                                        <ui:Button
                                                            Margin="0,6,0,0"
                                                            HorizontalAlignment="Right"
                                                            Appearance="Transparent"
                                                            Command="{Binding DataContext.ViewModel.DesinstalarCommand, ElementName=Raiz}"
                                                            CommandParameter="{Binding}"
                                                            Content="{l:T 'Desinstalar'}"
                                                            Visibility="{Binding PuedeDesinstalar, Converter={StaticResource BoolAVisibilidad}}">
                                                            <ui:Button.Icon>
                                                                <ui:SymbolIcon Symbol="Delete24" />
                                                            </ui:Button.Icon>
                                                        </ui:Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
