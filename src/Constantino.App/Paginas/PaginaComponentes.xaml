<Page
    x:Class="Constantino.App.Paginas.PaginaComponentes"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Componentes">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,24,32,32" MaxWidth="1040">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="Componentes" />
            <TextBlock
                Margin="0,4,0,4"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Todo lo que Constantino puede instalar. Instala solo lo que vayas a usar: puedes añadir o quitar componentes cuando quieras."
                TextWrapping="Wrap" />
            <TextBlock Margin="0,0,0,8" Text="{Binding ViewModel.ResumenDispositivo}" TextWrapping="Wrap" />

            <ui:InfoBar
                Margin="0,0,0,8"
                IsClosable="False"
                IsOpen="True"
                Message="Esta versión todavía no instala nada: los botones se activarán en la siguiente (hito H1)."
                Severity="Informational"
                Title="Vista previa" />

            <ui:ProgressRing
                Width="24"
                Height="24"
                HorizontalAlignment="Left"
                IsIndeterminate="True"
                Visibility="{Binding ViewModel.Cargando, Converter={StaticResource BoolAVisibilidad}}" />

            <ItemsControl ItemsSource="{Binding ViewModel.Grupos}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,16,0,0">
                            <TextBlock Margin="0,0,0,8" FontSize="18" FontWeight="SemiBold" Text="{Binding Nombre}" />
                            <ItemsControl ItemsSource="{Binding Tarjetas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Card Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Nombre}" />
                                                        <ui:Badge Margin="12,0,0,0" Appearance="{Binding Apariencia}" Content="{Binding Etiqueta}" />
                                                    </StackPanel>
                                                    <TextBlock Margin="0,6,0,0" Text="{Binding Resumen}" TextWrapping="Wrap" />
                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        FontStyle="Italic"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding Motivo}"
                                                        TextWrapping="Wrap" />
                                                    <Expander Margin="0,8,0,0" Header="Más información">
                                                        <StackPanel Margin="0,8,0,0">
                                                            <TextBlock Text="{Binding Detalle}" TextWrapping="Wrap" />
                                                            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap">
                                                                <Run FontWeight="SemiBold" Text="Sirve para: " /><Run Text="{Binding Habilita, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap">
                                                                <Run FontWeight="SemiBold" Text="Necesita: " /><Run Text="{Binding Necesita, Mode=OneWay}" />
                                                            </TextBlock>
                                                            <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Licencias:" />
                                                            <ItemsControl ItemsSource="{Binding Licencias}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <ui:HyperlinkButton
                                                                            Padding="0,2"
                                                                            Content="{Binding Nombre}"
                                                                            NavigateUri="{Binding Url}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Expander>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="24,0,0,0" MinWidth="130" HorizontalAlignment="Right">
                                                    <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding Tamano}" />
                                                    <TextBlock
                                                        HorizontalAlignment="Right"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                        Text="{Binding Estado}" />
                                                    <ui:Button
                                                        Margin="0,12,0,0"
                                                        HorizontalAlignment="Right"
                                                        Content="Instalar"
                                                        IsEnabled="False"
                                                        ToolTip="La instalación llegará en la próxima versión (hito H1)."
                                                        ToolTipService.ShowOnDisabled="True">
                                                        <ui:Button.Icon>
                                                            <ui:SymbolIcon Symbol="ArrowDownload24" />
                                                        </ui:Button.Icon>
                                                    </ui:Button>
                                                </StackPanel>
                                            </Grid>
                                        </ui:Card>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
