<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Constantino</AssemblyName>
    <RootNamespace>Constantino.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Constantino.Core\Constantino.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\catalogo\catalogo.json" Link="catalogo.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- El motor Python viaja con la app: cada versión de Constantino lleva su motor emparejado. -->
    <Content Include="..\..\motores\**\*.py" LinkBase="motores" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
