<Application
    x:Class="Constantino.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controles="clr-namespace:Constantino.App.Controles"
    DispatcherUnhandledException="AlFallarSinControl">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolAVisibilidad" />
            <controles:TextoNoVacio x:Key="TextoNoVacio" />
            <controles:BoolInversoAVisibilidad x:Key="BoolInversoAVisibilidad" />
            <controles:NoNuloAVisibilidad x:Key="NoNuloAVisibilidad" />
            <controles:NegarBool x:Key="NegarBool" />
            <controles:NumeroAVisibilidad x:Key="NumeroAVisibilidad" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
