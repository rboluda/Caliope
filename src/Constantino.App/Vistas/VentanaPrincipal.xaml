<ui:FluentWindow
    x:Class="Constantino.App.Vistas.VentanaPrincipal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:paginas="clr-namespace:Constantino.App.Paginas"
    Title="Calíope"
    Icon="pack://application:,,,/Recursos/caliope.png"
    Width="1180"
    Height="780"
    MinWidth="760"
    MinHeight="520"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="BarraTitulo" Title="Calíope" Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Recursos/caliope.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView
            x:Name="Navegacion"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            OpenPaneLength="220"
            PaneDisplayMode="Left">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Inicio" TargetPageType="{x:Type paginas:PaginaInicio}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Componentes" TargetPageType="{x:Type paginas:PaginaComponentes}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PuzzlePiece24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItemSeparator />
                <ui:NavigationViewItem Content="Voces" TargetPageType="{x:Type paginas:PaginaVoces}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Library24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Diseñar voz" TargetPageType="{x:Type paginas:PaginaDisenar}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Sparkle24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Clonar voz" TargetPageType="{x:Type paginas:PaginaClonar}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Mic24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Narrar" TargetPageType="{x:Type paginas:PaginaNarrar}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="BookOpen24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Ayuda" TargetPageType="{x:Type paginas:PaginaAyuda}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="QuestionCircle24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Ajustes" TargetPageType="{x:Type paginas:PaginaAjustes}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
