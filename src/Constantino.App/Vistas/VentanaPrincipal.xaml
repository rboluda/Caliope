<ui:FluentWindow
    x:Class="Constantino.App.Vistas.VentanaPrincipal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:paginas="clr-namespace:Constantino.App.Paginas"
    Title="Calíope"
    Icon="pack://application:,,,/Recursos/caliope.png"
    Width="1180"
    Height="780"
    MinWidth="760"
    MinHeight="520"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="BarraTitulo" Title="Calíope" Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Recursos/caliope.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!--  Aviso de versión nueva o de mejoras para componentes  -->
        <Border
            x:Name="Aviso"
            Grid.Row="1"
            Margin="12,4,12,8"
            Padding="16,10"
            Background="{DynamicResource ControlFillColorDefaultBrush}"
            BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Visibility="{Binding Visible, Converter={StaticResource BoolAVisibilidad}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon VerticalAlignment="Center" FontSize="22" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Symbol="ArrowCircleUp24" />
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Titulo}" />
                    <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Mensaje}" TextWrapping="Wrap" />
                    <ProgressBar Margin="0,6,0,0" Maximum="1" Value="{Binding Progreso}" Visibility="{Binding Ocupado, Converter={StaticResource BoolAVisibilidad}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:Button
                        Margin="0,0,6,0"
                        Appearance="Transparent"
                        Command="{Binding VerNovedadesCommand}"
                        Content="Novedades"
                        Visibility="{Binding HayNovedades, Converter={StaticResource BoolAVisibilidad}}" />
                    <ui:Button
                        Appearance="Primary"
                        Command="{Binding AccionCommand}"
                        Content="{Binding TextoBoton}"
                        IsEnabled="{Binding Ocupado, Converter={StaticResource NegarBool}}" />
                    <ui:Button
                        Margin="6,0,0,0"
                        Appearance="Transparent"
                        Command="{Binding CerrarCommand}"
                        IsEnabled="{Binding Ocupado, Converter={StaticResource NegarBool}}"
                        ToolTip="Ahora no">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Dismiss24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <ui:NavigationView
            x:Name="Navegacion"
            Grid.Row="2"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="True"
            OpenPaneLength="220"
            PaneDisplayMode="Left">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Inicio" TargetPageType="{x:Type paginas:PaginaInicio}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Componentes" TargetPageType="{x:Type paginas:PaginaComponentes}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PuzzlePiece24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItemSeparator />
                <ui:NavigationViewItem Content="Voces" TargetPageType="{x:Type paginas:PaginaVoces}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Library24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Diseñar voz" TargetPageType="{x:Type paginas:PaginaDisenar}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Sparkle24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Clonar voz" TargetPageType="{x:Type paginas:PaginaClonar}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Mic24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Narrar" TargetPageType="{x:Type paginas:PaginaNarrar}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="BookOpen24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Ayuda" TargetPageType="{x:Type paginas:PaginaAyuda}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="QuestionCircle24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Ajustes" TargetPageType="{x:Type paginas:PaginaAjustes}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
