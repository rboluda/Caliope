        "Todo lo demás"
      ],
      "dependeDe": [],
      "tamano": {
        "conGpuGb": 0.3,
        "sinGpuGb": 0.3
      },
      "requisitos": {
        "funcionaEnCpu": true
      },
      "licencias": [
        {
          "nombre": "uv: MIT / Apache 2.0",
          "url": "https://github.com/astral-sh/uv/blob/main/LICENSE-MIT"
        },
        {
          "nombre": "Python: PSF",
          "url": "https://docs.python.org/3/license.html"
        },
        {
          "nombre": "ffmpeg: GPL",
