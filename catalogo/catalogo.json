{
  "version": 1,
  "componentes": [
    {
      "id": "nucleo",
      "nombre": "Núcleo",
      "grupo": "Básico",
      "necesidad": "imprescindible",
      "resumen": "Las herramientas básicas sobre las que funciona todo lo demás.",
      "detalle": "Instala uv (un gestor que descarga Python y sus paquetes de forma rápida y aislada), Python 3.11 y ffmpeg (convierte audio a MP3, ajusta el volumen y cambia velocidad y tono). No toca ningún Python que ya tengas en el equipo.",
      "habilita": [
        "Todo lo demás"
      ],
      "dependeDe": [],
      "tamano": {
        "conGpuGb": 0.3,
        "sinGpuGb": 0.3
      },
      "requisitos": {
        "funcionaEnCpu": true
      },
      "licencias": [
        {
          "nombre": "uv: MIT / Apache 2.0",
          "url": "https://github.com/astral-sh/uv/blob/main/LICENSE-MIT"
        },
        {
          "nombre": "Python: PSF",
          "url": "https://docs.python.org/3/license.html"
        },
        {
          "nombre": "ffmpeg: GPL",
          "url": "https://ffmpeg.org/legal.html"
        }
      ],
      "instalacion": {
        "version": "uv 0.12.24 · Python 3.11 · ffmpeg 9.0.2",
        "pasos": [
          {
            "tipo": "descargar",
            "descripcion": "Descargando uv",
            "url": "https://github.com/astral-sh/uv/releases/download/0.12.24/uv-x86_64-pc-windows-msvc.zip",
            "sha256": "7c38608c8a18ee137d748a1773053b07ec8f3a30fab49aebaa6f4e4efeceb019",
            "destino": "{descargas}/uv-0.12.24.zip",
            "tamanoBytes": 15685515
          },
          {
            "tipo": "extraer",
            "descripcion": "Descomprimiendo uv",
            "archivo": "{descargas}/uv-0.12.24.zip",
            "destino": "{herramientas}/uv"
          },
          {
            "tipo": "ejecutar",
            "descripcion": "Instalando Python 3.11",
            "programa": "{uv}",
            "argumentos": [
              "python",
              "install",
              "3.11"
            ]
          },
          {
            "tipo": "ejecutar",
            "descripcion": "Comprobando Python",
            "programa": "{uv}",
            "argumentos": [
              "python",
              "find",
              "3.11"
            ],
            "debeContener": "python.exe"
          },
          {
            "tipo": "descargar",
            "descripcion": "Descargando ffmpeg",
            "url": "https://github.com/GyanD/codexffmpeg/releases/download/9.0.2/ffmpeg-9.0.2-essentials_build.zip",
            "sha256": "60f467265b1e312373dbcd92200c2618a74850f98d3d078e94296bb3fa2047ba",
            "destino": "{descargas}/ffmpeg-9.0.2-essentials.zip",
            "tamanoBytes": 114768076
          },
          {
            "tipo": "extraer",
            "descripcion": "Descomprimiendo ffmpeg",
            "archivo": "{descargas}/ffmpeg-9.0.2-essentials.zip",
            "destino": "{herramientas}/ffmpeg",
            "quitarCarpetaRaiz": true,
            "incluir": [
              "bin/ffmpeg.exe",
              "bin/ffprobe.exe",
              "LICENSE"
            ]
          },
          {
            "tipo": "ejecutar",
            "descripcion": "Comprobando ffmpeg",
            "programa": "{ffmpeg}",
            "argumentos": [
              "-hide_banner",
              "-filters"
            ],
            "debeContener": "rubberband"
          }
        ],
        "rutas": [
          "{herramientas}/uv",
          "{herramientas}/ffmpeg",
          "{python}"
        ],
        "comprobar": [
          "{uv}",
          "{ffmpeg}"
        ]
      }
    },
    {
      "id": "motor-qwen",
      "nombre": "Motor de voz Qwen3-TTS",
      "grupo": "Motor de voz",
      "necesidad": "imprescindible",
      "resumen": "El programa que convierte texto en voz. Sin él, Constantino no puede hablar.",
      "detalle": "Crea un entorno de Python propio con PyTorch (con CUDA si tienes una tarjeta NVIDIA compatible, o para procesador si no) y la librería qwen-tts. Por sí solo no trae ninguna voz: necesita al menos uno de los modelos Base.",
      "habilita": [
        "Narrar",
        "Clonar voces",
        "Diseñar voces (con el modelo VoiceDesign)"
      ],
      "dependeDe": [
        "nucleo"
      ],
      "tamano": {
        "conGpuGb": 5.0,
        "sinGpuGb": 1.2
      },
      "requisitos": {
        "funcionaEnCpu": true
      },
      "licencias": [
        {
          "nombre": "Qwen3-TTS: Apache 2.0",
          "url": "https://github.com/QwenLM/Qwen3-TTS/blob/main/LICENSE"
        },
        {
          "nombre": "PyTorch: BSD-3",
          "url": "https://github.com/pytorch/pytorch/blob/main/LICENSE"
        }
      ],
      "instalacion": {
        "version": "qwen-tts 0.1.1 · torch 2.11.0",
        "pasos": [
          {
            "tipo": "ejecutar",
            "descripcion": "Creando el entorno de Python",
            "programa": "{uv}",
            "argumentos": [
              "venv",
              "{entornos}/qwen3tts",
              "--python",
              "3.11",
              "--clear"
            ]
          },
          {
            "tipo": "ejecutar",
            "descripcion": "Instalando PyTorch (la parte más pesada)",
            "programa": "{uv}",
            "argumentos": [
              "pip",
              "install",
              "--compile-bytecode",
              "--python",
              "{entornos}/qwen3tts/Scripts/python.exe",
              "torch==2.11.0",
              "torchaudio==2.11.0",
              "--index-url",
              "{indiceTorch}"
            ],
            "progreso": {
              "carpetas": [
                "{cache}/uv",
                "{entornos}/qwen3tts"
              ],
              "bytesConGpu": 4530000000,
              "bytesSinGpu": 1000000000
            }
          },
          {
            "tipo": "ejecutar",
            "descripcion": "Instalando qwen-tts",
            "programa": "{uv}",
            "argumentos": [
              "pip",
              "install",
              "--compile-bytecode",
              "--python",
              "{entornos}/qwen3tts/Scripts/python.exe",
              "qwen-tts==0.1.1"
            ],
            "progreso": {
              "carpetas": [
                "{cache}/uv",
                "{entornos}/qwen3tts"
              ],
              "bytesConGpu": 600000000,
              "bytesSinGpu": 600000000
            }
          },
          {
            "tipo": "ejecutar",
            "descripcion": "Comprobando que el motor arranca",
            "programa": "{entornos}/qwen3tts/Scripts/python.exe",
            "argumentos": [
              "-c",
              "import torch, qwen_tts; print('dispositivo=' + ('cuda' if torch.cuda.is_available() else 'cpu'))"
            ],
            "debeContener": "dispositivo={dispositivo}"
          }
        ],
        "rutas": [
          "{entornos}/qwen3tts"
        ],
        "comprobar": [
          "{entornos}/qwen3tts/Scripts/python.exe"
        ]
      }
    },
    {
